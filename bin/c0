#!/bin/bash
# SPDX-FileCopyrightText: 2026 Tomas Gonzalez
# SPDX-License-Identifier: MIT

# Service management script for c0dev environment
# Usage: ./c0 [start [--least-privilege]|stop|restart [--least-privilege]|...|help]

set -e

# =============================================================================
# Colors for output
# =============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[0;37m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# =============================================================================
# Preconditions (fail-fast)
# =============================================================================

# Repo root from this script's real path (multi-instance isolation key).
# Instance id hashes this realpath tree; symlinks/cwd must not fork a second id.
C0_BIN="$(realpath "${BASH_SOURCE[0]}")"
C0ROOT="$(realpath "$(dirname "$C0_BIN")/..")"
C0_TERMINFO_SHA256=""
C0_BASE_BUILD_ID=""
C0_BASE_RECIPE_ID=""

# Required files - exit non-zero if any are missing
REQUIRED_FILES=(
    "$C0ROOT/docker/home-overlays.conf"
    "$C0ROOT/docker/c0-overlay-check"
    "$C0ROOT/bin/c0-host-io"
    "$C0ROOT/bin/c0-credentials"
)

for f in "${REQUIRED_FILES[@]}"; do
    if [[ ! -f "$f" ]]; then
        echo "error: required file missing: $f" >&2
        exit 1
    fi
done

# Detect if running inside container
if [[ -f /.dockerenv ]] || grep -q docker /proc/1/cgroup 2>/dev/null; then
    IN_CONTAINER=true
else
    IN_CONTAINER=false
fi

# =============================================================================
# Instance id (docker compose -p; one per c0dev checkout path)
# =============================================================================

# Web port allocation
# =============================================================================

# Host port range used to map guest:3000 -> host:<port>
C0DEV_WEB_PORT_MIN=3000
C0DEV_WEB_PORT_MAX=4000
C0DEV_SSH_PORT_MIN=2222
C0DEV_SSH_PORT_MAX=2322
C0DEV_ORCA_GUEST_PORT=6768
C0_SSH_DIR="$C0ROOT/auth/ssh"
C0_SSH_CLIENT_DIR="$C0ROOT/auth/ssh-client"
C0_AUTH_ENV_FILE="$C0ROOT/auth/.env"

# C0_MODE validation: only "" (prod) or "dev" allowed
if [[ -n "$C0_MODE" && "$C0_MODE" != "dev" ]]; then
    echo "error: C0_MODE must be empty (production) or 'dev', got: '$C0_MODE'" >&2
    exit 1
fi

# Short hash function (first 8 chars of sha256)
short_hash() {
    echo -n "$1" | shasum -a 256 | cut -c1-8
}

# Docker instance id for a c0dev tree (realpath) and mode.
c0_instance_id_for() {
    local c0root="$1" mode="${2:-}" build="${3:-}" root_real prefix=c0dev
    root_real="$(realpath "$c0root" 2>/dev/null)" || root_real="$c0root"
    [[ "$mode" != dev ]] || prefix=c0dev-dev
    if [[ -n "$build" ]]; then
        printf '%s-%s\n' "$prefix" "$(short_hash "$mode:$build:$root_real")"
    elif [[ "$mode" == dev ]]; then
        printf '%s-%s\n' "$prefix" "$(short_hash "$root_real:dev")"
    else
        printf '%s-%s\n' "$prefix" "$(short_hash "$root_real")"
    fi
}

if [[ "$C0_MODE" == "dev" ]]; then
    SHARED_TOOLS_VOLUME="c0dev-tools-shared-dev"
else
    SHARED_TOOLS_VOLUME="c0dev-tools-shared"
fi
C0_MODE_KEY="${C0_MODE:-prod}"
C0_WORKSPACE_ID="$(c0_instance_id_for "$C0ROOT" "$C0_MODE")"
C0_INSTANCE_ID="$C0_WORKSPACE_ID"

# Internal Compose inputs. Runtime creation derives these from Docker volumes;
# inherited environment values must not select storage or affect image builds.
export C0_HOME_OVERLAYS_VOLUME="${C0_INSTANCE_ID}-home-overlays"
export C0_HOME_OVERLAYS_EXTERNAL=false

# Hash logical input names and contents, never the checkout's absolute path.
c0_tools_recipe_hash() {
    local recipe helper
    recipe="$(cd "$C0ROOT" && "$C0ROOT/bin/docker-hash" docker/Dockerfile.base docker/Dockerfile.tools)" || return 1
    helper="$(shasum -a 256 <"$C0ROOT/docker/c0-security.py")" || return 1
    printf 'c0-tools-recipe-v2\n%s\n%s\n' "$recipe" "${helper:0:64}" | shasum -a 256 | awk '{print $1}'
}

c0_base_recipe_hash() {
    local recipe helper
    recipe="$(cd "$C0ROOT" && "$C0ROOT/bin/docker-hash" docker/Dockerfile.base)" || return 1
    helper="$(shasum -a 256 <"$C0ROOT/docker/c0-security.py")" || return 1
    printf 'c0-base-recipe-v1\n%s\n%s\n' "$recipe" "${helper:0:64}" | shasum -a 256 | awk '{print $1}'
}

c0_recipe_hash() {
    local input digest values
    digest="$(cd "$C0ROOT" && "$C0ROOT/bin/docker-hash" \
        docker/Dockerfile.base docker/Dockerfile.tools docker/Dockerfile.runtime)" || return 1
    values="c0-recipe-v1"$'\n'"$digest"
    for input in 1password.asc cloud.google.gpg install-orca.sh docker-entrypoint.sh \
        c0-security.py; do
        digest="$(shasum -a 256 <"$C0ROOT/docker/$input")" || return 1
        values+=$'\n'"docker/$input:${digest:0:64}"
    done
    printf '%s\n' "$values" | shasum -a 256 | awk '{print $1}'
}

if ! TOOLS_RECIPE_ID="$(c0_tools_recipe_hash 2>/dev/null)" ||
   ! C0_RECIPE_ID="$(c0_recipe_hash 2>/dev/null)"; then
    # Retained runtime operations consume Docker state, not draft recipes.
    if [[ "${1:-}" == build ]]; then
        echo 'error: required image-construction inputs are missing or unreadable' >&2
        exit 1
    fi
    TOOLS_RECIPE_ID=""
    C0_RECIPE_ID=""
fi
TOOLS_BUILD_ID="$TOOLS_RECIPE_ID"
TOOLS_ID="$TOOLS_BUILD_ID"
TOOLS_PREFIX="/tools/current"

c0_runtime_recipe_ref() {
    printf 'c0dev-runtime-%s:recipe-%s\n' "$C0_MODE_KEY" "$C0_RECIPE_ID"
}

c0_set_build_identity() {
    local build="$1"
    [[ "$build" =~ ^[0-9a-f]{64}$ ]] || {
        echo 'error: invalid shared build identity' >&2; return 1;
    }
    C0_BUILD_ID="$build"
    C0_RUNTIME_IMAGE="c0dev-runtime-${C0_MODE_KEY}:$build"
    C0_BASE_IMAGE="c0dev-base-${C0_MODE_KEY}:${C0_BASE_BUILD_ID:-$build}"
    C0_TOOLS_BUILDER_IMAGE="c0dev-tools-builder-${C0_MODE_KEY}:$TOOLS_BUILD_ID"
    C0_INSTANCE_ID="$(c0_instance_id_for "$C0ROOT" "$C0_MODE" "$build")" || return 1
    export C0_BUILD_ID C0_RUNTIME_IMAGE C0_BASE_IMAGE C0_INSTANCE_ID C0_WORKSPACE_ID
}

# The shared recipe tag is Docker's publication of the current completed build.
# Its labels supply the exact payload; no checkout-side selector is consulted.
c0_resolve_shared_build() {
    local reference metadata image build mode recipe tools volume base candidates
    reference="$(c0_runtime_recipe_ref)" || return 1
    if ! docker image inspect "$reference" >/dev/null 2>&1; then
        reference="c0dev-runtime-${C0_MODE_KEY}:current"
        if ! docker image inspect "$reference" >/dev/null 2>&1; then
            # Compatibility with completed publications predating :current.
            # Never pick a staging image or select among old builds by age.
            candidates="$(docker image ls -aq \
                --filter "reference=c0dev-runtime-${C0_MODE_KEY}:recipe-*" \
                --filter "label=c0dev.mode=$C0_MODE_KEY" \
                --filter "label=c0dev.tools_volume=$SHARED_TOOLS_VOLUME" | LC_ALL=C sort -u)" || return 1
            if [[ -z "$candidates" ]]; then
                echo "error: no completed shared image for this mode; run 'c0 build'" >&2
                return 1
            fi
            if [[ "$candidates" == *$'\n'* ]]; then
                echo "error: ambiguous completed images without a current publication; run 'c0 build' to publish one" >&2
                return 1
            fi
            reference="$candidates"
        fi
    fi
    metadata="$(docker image inspect --format '{{printf "%s\t%s\t%s\t%s\t%s\t%s\t%s" .Id (index .Config.Labels "c0dev.build") (index .Config.Labels "c0dev.mode") (index .Config.Labels "c0dev.recipe") (index .Config.Labels "c0dev.tools_hash") (index .Config.Labels "c0dev.tools_volume") (index .Config.Labels "c0dev.base_image")}}' "$reference")" || {
        echo "error: no completed shared image for this mode and recipe; run 'c0 build'" >&2
        return 1
    }
    IFS=$'\t' read -r image build mode recipe tools volume base <<<"$metadata"
    if [[ ! "$image" =~ ^sha256:[0-9a-f]{64}$ || ! "$build" =~ ^[0-9a-f]{64}$ ||
          ! "$tools" =~ ^[0-9a-f]{64}$ || "$mode" != "$C0_MODE_KEY" ||
          ! "$recipe" =~ ^[0-9a-f]{64}$ || "$volume" != "$SHARED_TOOLS_VOLUME" ||
          ! "$base" =~ ^c0dev-base-${C0_MODE_KEY}:[0-9a-f]{64}$ ]]; then
        echo 'error: shared image metadata does not match this mode and construction identity' >&2
        return 1
    fi
    c0_set_build_identity "$build" || return 1
    C0_RECIPE_ID="$recipe"
    set_tools_id "$tools" || return 1
    TOOLS_BUILD_ID="$tools"
    # Creation uses the inspected immutable image, even if a build retags the
    # shared recipe while this invocation is preparing its mounts.
    C0_RUNTIME_IMAGE="$image"
    C0_BASE_IMAGE="$base"
    export C0_RUNTIME_IMAGE C0_BASE_IMAGE
}

DOCKERFILE_BASE="$C0ROOT/docker/Dockerfile.base"
DOCKERFILE_TOOLS="$C0ROOT/docker/Dockerfile.tools"
DOCKERFILE_RUNTIME="$C0ROOT/docker/Dockerfile.runtime"
# Generated paths are assigned per invocation by cmd_build; never shared across
# checkouts, forks, or concurrent builds.

c0_prepare_build_context() {
    mkdir -p "$C0_BUILD_CONTEXT/.terminfo" || return 1
    local input
    for input in 1password.asc cloud.google.gpg install-orca.sh docker-entrypoint.sh \
        c0-security.py; do
        cp "$C0ROOT/docker/$input" "$C0_BUILD_CONTEXT/$input" || return 1
    done
}

c0_prepare_tools_dockerfile() {
    "$C0ROOT/bin/dockerfile-concat" -o "$DOCKERFILE_TOOLS_BUILD" \
        "$DOCKERFILE_BASE" "$DOCKERFILE_TOOLS"
}

c0_prepare_runtime_dockerfile() {
    "$C0ROOT/bin/dockerfile-concat" -o "$DOCKERFILE_RUNTIME_BUILD" \
        "$DOCKERFILE_BASE" "$DOCKERFILE_RUNTIME"
}

c0_prepare_terminfo() {
    local input digest values=c0-runtime-terminfo-v1 caller_term=""
    local LC_ALL=C
    # Bash synthesizes a non-exported TERM=dumb in a headless environment.
    # Only an inherited caller value is a terminal selection for this build.
    if [[ "$(declare -p TERM 2>/dev/null)" == 'declare -x '* ]]; then caller_term="${TERM-}"; fi
    TERM="$caller_term" "$C0ROOT/bin/c0-terminfo" prepare "$C0_BUILD_CONTEXT/.terminfo" || return 1
    for input in "$C0_BUILD_CONTEXT/.terminfo/"*; do
        [[ -f "$input" && ! -L "$input" ]] || return 1
        digest="$(shasum -a 256 <"$input")" || return 1
        values+=$'\n'"${input##*/}:${digest:0:64}"
    done
    C0_TERMINFO_SHA256="$(printf '%s\n' "$values" | shasum -a 256 | awk '{print $1}')" || return 1
}

c0_resolve_toolchain() {
    local manifest="$C0_BUILD_CONTEXT/c0-toolchain.json" manifest_sha line bun_version=""
    local args_file="$C0_BUILD_CONTEXT/.toolchain-build-args"
    echo "🔎 Resolving current toolchain releases (Node 22, Python 3.15)..."
    "$C0ROOT/bin/c0-toolchain" --output "$manifest" || return 1
    "$C0ROOT/bin/c0-toolchain" --build-args "$manifest" >"$args_file" || return 1
    C0_TOOLCHAIN_BUILD_ARGS=()
    while IFS= read -r line; do
        C0_TOOLCHAIN_BUILD_ARGS+=(--build-arg "$line")
        case "$line" in BUN_VERSION=*) bun_version="${line#BUN_VERSION=}" ;; esac
    done <"$args_file"
    manifest_sha="$(shasum -a 256 "$manifest" | awk '{print $1}')" || return 1
    TOOLS_BUILD_ID="$(printf 'c0-toolchain-build-v1\n%s\n%s\n' \
        "${TOOLS_RECIPE_ID:-$TOOLS_BUILD_ID}" "$manifest_sha" | shasum -a 256 | awk '{print $1}')" || return 1
    set_tools_id "$TOOLS_BUILD_ID" || return 1
    local build
    build="$(printf 'c0-runtime-build-v1\n%s\n%s\n' \
        "$C0_RECIPE_ID" "$manifest_sha" | shasum -a 256 | awk '{print $1}')" || return 1
    if [[ -n "${C0_TERMINFO_SHA256:-}" ]]; then
        build="$(printf 'c0-runtime-build-v2\n%s\n%s\n%s\n%s\n' \
            "$C0_RECIPE_ID" "$manifest_sha" "$TOOLS_ID" "$C0_TERMINFO_SHA256" | shasum -a 256 | awk '{print $1}')" || return 1
        [[ -n "$bun_version" ]] || { echo 'error: missing Bun selection for the base image' >&2; return 1; }
        C0_BASE_RECIPE_ID="$(c0_base_recipe_hash)" || return 1
        C0_BASE_BUILD_ID="$(printf 'c0-base-build-v1\n%s\n%s\n' \
            "$C0_BASE_RECIPE_ID" "$bun_version" | shasum -a 256 | awk '{print $1}')" || return 1
    fi
    c0_set_build_identity "$build" || return 1
    # The supervisor lives in another process. Publish the worker's actual ID
    # before it can create build artifacts so cancellation cleans the right one.
    printf '%s\n' "$TOOLS_BUILD_ID" >"$C0_BUILD_CONTEXT/.c0-build-id.next" || return 1
    mv "$C0_BUILD_CONTEXT/.c0-build-id.next" "$C0_BUILD_CONTEXT/.c0-build-id"
}

# =============================================================================
# Compose file paths
# =============================================================================

COMPOSE_PUBLIC_FILE="$C0ROOT/docker/docker-compose.public.yaml"
COMPOSE_SECURITY_GUEST_ADMIN="$C0ROOT/docker/docker-compose.security-guest-admin.yaml"
COMPOSE_SECURITY_LEAST_PRIVILEGE="$C0ROOT/docker/docker-compose.security-least-privilege.yaml"
# OrbStack / Docker Desktop agent relay path inside the Linux VM (not a macOS socket).
C0_SSH_AUTH_SOCK_PATH="/run/host-services/ssh-auth.sock"
VOLUMES_FOLDERS_FILE="$C0ROOT/docker/volumes-folders.yaml"
VOLUMES_FILES_FILE="$C0ROOT/docker/volumes-files.yaml"
HOME_OVERLAYS_FILE="$C0ROOT/docker/home-overlays.conf"
MAIN_SERVICE="c0dev"
CONTAINER_DEV_HOME="/home/dev"
C0_ORCA_PID_GUEST="${CONTAINER_DEV_HOME}/.local-rw/c0-orca-serve.pid"
C0_ORCA_LOG_GUEST="${CONTAINER_DEV_HOME}/.local-rw/c0-orca-serve.log"
C0_ORCA_LOG_HOST="${C0ROOT}/.local/c0-orca-serve.log"

# Vendored Moby reference seccomp (tag in docker/seccomp/moby-seccomp.tag)
SECCOMP_DIR="$C0ROOT/docker/seccomp"
SECCOMP_PROFILE_JSON="$SECCOMP_DIR/moby-default-seccomp.json"
SECCOMP_PROFILE_SHA="$SECCOMP_DIR/moby-default-seccomp.sha256"
SECCOMP_LOCAL_TAG_FILE="$SECCOMP_DIR/moby-seccomp.tag"
MOBY_PROFILES_GIT_URL="${MOBY_PROFILES_GIT_URL:-https://github.com/moby/profiles.git}"
# Ephemeral docker run helpers (tools volume I/O, unpack): align with least-privilege posture.
# Runtime service hardening: docker-compose.security-*.yaml (selected via C0_SECURITY).
c0_docker_run() {
    docker run --rm \
        --security-opt no-new-privileges:true \
        --cap-drop ALL \
        "$@"
}

# Refuse start/build if vendored seccomp was tampered with or removed.
verify_moby_seccomp_profile() {
    if [[ ! -f "$SECCOMP_PROFILE_JSON" ]]; then
        echo "error: seccomp profile missing: $SECCOMP_PROFILE_JSON" >&2
        return 1
    fi
    if [[ ! -f "$SECCOMP_PROFILE_SHA" ]]; then
        echo "error: seccomp checksum file missing: $SECCOMP_PROFILE_SHA" >&2
        return 1
    fi
    if ! (cd "$SECCOMP_DIR" && shasum -a 256 -c "moby-default-seccomp.sha256"); then
        echo "error: seccomp profile failed checksum verification" >&2
        return 1
    fi
    return 0
}

# --- Moby seccomp: query upstream; explicit vendored-profile updates ---

read_local_seccomp_tag() {
    if [[ ! -f "$SECCOMP_LOCAL_TAG_FILE" ]]; then
        echo ""
        return 0
    fi
    tr -d ' \t\r\n' <"$SECCOMP_LOCAL_TAG_FILE" | head -c 200
}

read_local_seccomp_profile_sha256() {
    if [[ ! -f "$SECCOMP_PROFILE_SHA" ]]; then
        echo ""
        return 0
    fi
    awk '{print $1; exit}' "$SECCOMP_PROFILE_SHA"
}

# Resolve latest seccomp/vM.m.p on upstream using git ls-remote (TLS to GitHub).
# Annotated tags: use peeled refs/tags/...^{}; lightweight: single ref line.
# Prints: remote_tag<TAB>commit_oid on stdout; return 1 if none or git missing.
moby_seccomp_resolve_upstream_latest() {
    if ! command -v git &>/dev/null; then
        return 1
    fi
    local lsout
    lsout="$(GIT_TERMINAL_PROMPT=0 git ls-remote --tags "$MOBY_PROFILES_GIT_URL" 2>/dev/null)" || return 1
    [[ -z "$lsout" ]] && return 1

    local pairs
    pairs="$(echo "$lsout" | awk '
    $2 ~ /^refs\/tags\/seccomp\/v[0-9]+\.[0-9]+\.[0-9]+\^\{\}$/ {
      n = $2
      sub(/^refs\/tags\//,"",n)
      sub(/\^\{\}$/,"",n)
      pe[n] = $1
      next
    }
    $2 ~ /^refs\/tags\/seccomp\/v[0-9]+\.[0-9]+\.[0-9]+$/ {
      n = $2
      sub(/^refs\/tags\//,"",n)
      lw[n] = $1
      next
    }
    END {
      for (n in lw) {
        if (n in pe) print n "\t" pe[n]
        else print n "\t" lw[n]
      }
    }')" || true
    [[ -z "$pairs" ]] && return 1

    local best_line
    best_line="$(
        while IFS=$'\t' read -r tag commit; do
            [[ -z "$tag" || -z "$commit" ]] && continue
            local ver="${tag#seccomp/v}"
            [[ "$ver" == "$tag" ]] && continue
            printf '%s\t%s\t%s\n' "$ver" "$tag" "$commit"
        done <<<"$pairs" | sort -t$'\t' -k1,1V | tail -1
    )" || true
    [[ -z "$best_line" ]] && return 1

    local remote_tag remote_commit
    remote_tag="$(echo "$best_line" | cut -f2)"
    remote_commit="$(echo "$best_line" | cut -f3)"
    [[ -z "$remote_tag" || -z "$remote_commit" ]] && return 1
    printf '%s\t%s\n' "$remote_tag" "$remote_commit"
}

# Exit 0 if $1 is semver-newer than $2 (both seccomp/vM.m.p); else 1.
moby_seccomp_tag_a_gt_b() {
    local a="${1#seccomp/v}"
    local b="${2#seccomp/v}"
    if [[ "$a" == "$1" || "$b" == "$2" ]]; then
        return 1
    fi
    if [[ "$(printf '%s\n' "$b" "$a" | sort -V | tail -1)" == "$a" ]] && [[ "$a" != "$b" ]]; then
        return 0
    fi
    return 1
}

# sha256 of default.json body for a tag (hex only).
moby_seccomp_profile_sha256_for_tag() {
    local tag="$1"
    local url="https://raw.githubusercontent.com/moby/profiles/refs/tags/${tag}/seccomp/default.json"
    curl -fsSL --connect-timeout 5 --max-time 45 \
        -H "User-Agent: c0dev-seccomp-check" \
        "$url" 2>/dev/null | shasum -a 256 | awk '{print $1}'
}

# After verify_moby: optionally notify if upstream has a newer seccomp tag than vendored.
# Set C0_SECCOMP_NOTIFY=0 to skip. Uses git ls-remote + curl (no JSON parser); failures are silent.
maybe_notify_seccomp_update_available() {
    if [[ "${C0_SECCOMP_NOTIFY:-1}" == "0" ]]; then
        return 0
    fi
    if ! command -v git &>/dev/null; then
        return 0
    fi

    local local_tag profile_local
    local_tag="$(read_local_seccomp_tag)"
    profile_local="$(read_local_seccomp_profile_sha256)"
    if [[ -z "$local_tag" ]]; then
        return 0
    fi

    local remote_tag remote_commit remote_profile pair
    pair="$(moby_seccomp_resolve_upstream_latest)" || return 0
    remote_tag="$(echo "$pair" | cut -f1)"
    remote_commit="$(echo "$pair" | cut -f2)"
    [[ -n "$remote_tag" ]] || return 0
    remote_profile="$(moby_seccomp_profile_sha256_for_tag "$remote_tag")"
    [[ -n "$remote_profile" ]] || return 0

    if ! moby_seccomp_tag_a_gt_b "$remote_tag" "$local_tag"; then
        return 0
    fi

    local ts
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    echo "" >&2
    echo -e "${YELLOW}${BOLD}c0 seccomp:${NC} newer Moby profile available than vendored copy." >&2
    echo -e "  ${BOLD}upstream tag:${NC}           ${CYAN}$remote_tag${NC}" >&2
    echo -e "  ${BOLD}upstream commit (git):${NC}    ${CYAN}$remote_commit${NC}" >&2
    echo -e "  ${BOLD}upstream profile sha256:${NC} ${CYAN}$remote_profile${NC}" >&2
    echo -e "  ${BOLD}vendored tag:${NC}            ${MAGENTA}$local_tag${NC}" >&2
    echo -e "  ${BOLD}vendored profile sha256:${NC} ${MAGENTA}$profile_local${NC}" >&2
    echo -e "  ${BOLD}notice generated (UTC):${NC}   $ts" >&2
    echo -e "  Run ${GREEN}c0 seccomp-upgrade${NC} to download and replace ${CYAN}docker/seccomp/*${NC} (optional: ${GREEN}--dry-run${NC})." >&2
    echo "" >&2
    return 0
}

cmd_seccomp_upgrade() {
    require_host "seccomp-upgrade"

    if ! command -v git &>/dev/null; then
        echo "error: git is required for seccomp-upgrade (git ls-remote to moby/profiles)" >&2
        exit 1
    fi

    if [[ ! -f "$SECCOMP_LOCAL_TAG_FILE" ]] || [[ -z "$(read_local_seccomp_tag)" ]]; then
        echo "error: missing or empty $SECCOMP_LOCAL_TAG_FILE" >&2
        exit 1
    fi

    local dry_run=false
    if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
        dry_run=true
    fi

    local pair remote_tag remote_commit
    if ! pair="$(moby_seccomp_resolve_upstream_latest)"; then
        echo "error: git ls-remote failed or no seccomp/vM.m.p tags (network, auth, or repo URL)" >&2
        exit 1
    fi
    remote_tag="$(echo "$pair" | cut -f1)"
    remote_commit="$(echo "$pair" | cut -f2)"

    local local_tag
    local_tag="$(read_local_seccomp_tag)"

    if [[ "$remote_tag" == "$local_tag" ]]; then
        echo -e "${GREEN}seccomp:${NC} already on latest Moby tag ${CYAN}$remote_tag${NC}"
        exit 0
    fi

    if ! moby_seccomp_tag_a_gt_b "$remote_tag" "$local_tag"; then
        echo -e "${YELLOW}seccomp:${NC} vendored tag ${MAGENTA}$local_tag${NC} is newer than upstream latest ${CYAN}$remote_tag${NC} (no downgrade)." >&2
        exit 0
    fi

    local remote_profile url
    remote_profile="$(moby_seccomp_profile_sha256_for_tag "$remote_tag")"
    if [[ -z "$remote_profile" ]]; then
        echo "error: failed to download or hash profile for $remote_tag" >&2
        exit 1
    fi
    url="https://raw.githubusercontent.com/moby/profiles/refs/tags/${remote_tag}/seccomp/default.json"

    echo -e "${BOLD}Moby seccomp upgrade${NC}"
    echo -e "  from: ${MAGENTA}$local_tag${NC} (profile sha256 $(read_local_seccomp_profile_sha256))"
    echo -e "  to:   ${CYAN}$remote_tag${NC}"
    echo -e "  commit (git peeled ref): ${CYAN}$remote_commit${NC}"
    echo -e "  new profile sha256: ${CYAN}$remote_profile${NC}"
    echo -e "  url: ${BLUE}$url${NC}"

    if [[ "$dry_run" == true ]]; then
        echo -e "${YELLOW}dry-run:${NC} no files written. Remove --dry-run to apply."
        exit 0
    fi

    local tmpjson
    tmpjson="$(mktemp "${TMPDIR:-/tmp}/c0-seccomp-json.XXXXXX")"
    if ! curl -fsSL --connect-timeout 5 --max-time 60 \
        -H "User-Agent: c0dev-seccomp-check" \
        "$url" -o "$tmpjson"; then
        rm -f "$tmpjson"
        echo "error: failed to download profile" >&2
        exit 1
    fi
    local gotsha
    gotsha="$(shasum -a 256 "$tmpjson" | awk '{print $1}')"
    if [[ "$gotsha" != "$remote_profile" ]]; then
        rm -f "$tmpjson"
        echo "error: downloaded profile sha256 mismatch (expected $remote_profile got $gotsha)" >&2
        exit 1
    fi

    mv "$tmpjson" "$SECCOMP_PROFILE_JSON"
    (
        cd "$SECCOMP_DIR" || exit 1
        shasum -a 256 moby-default-seccomp.json >moby-default-seccomp.sha256.tmp
        mv moby-default-seccomp.sha256.tmp moby-default-seccomp.sha256
    )
    printf '%s\n' "$remote_tag" >"$SECCOMP_LOCAL_TAG_FILE"

    if ! verify_moby_seccomp_profile; then
        echo "error: upgraded files failed verification (restore from git)" >&2
        exit 1
    fi

    echo -e "${GREEN}seccomp:${NC} wrote ${CYAN}$SECCOMP_PROFILE_JSON${NC}, checksum, and ${CYAN}$SECCOMP_LOCAL_TAG_FILE${NC}"
    exit 0
}

# =============================================================================
# C0_SECURITY: guest-admin (default) | least-privilege — env or start/restart --least-privilege
# =============================================================================

validate_c0_security_value() {
    case "$1" in
        guest-admin|least-privilege) return 0 ;;
        *)
            echo "error: C0_SECURITY must be 'guest-admin' or 'least-privilege', got: '$1'" >&2
            return 1
            ;;
    esac
}

c0_security_compose_file() {
    case "$C0_SECURITY" in
        guest-admin) echo "$COMPOSE_SECURITY_GUEST_ADMIN" ;;
        least-privilege) echo "$COMPOSE_SECURITY_LEAST_PRIVILEGE" ;;
        *)
            echo "error: internal: unknown C0_SECURITY=$C0_SECURITY" >&2
            return 1
            ;;
    esac
}

# Fail if docker is unreachable (do not treat as "no containers").
c0_require_docker() {
    local err
    if ! err="$(docker version --format '{{.Server.Version}}' 2>&1)"; then
        echo "error: docker is not reachable — ${err}" >&2
        return 1
    fi
    return 0
}

# Resolve one instance by label, including Compose one-off containers. Never
# choose an arbitrary match: start, attach, and metadata must agree on identity.
c0_list_instance_containers() {
    local arg rows cid name
    local -a options=()
    for arg in "$@"; do
        case "$arg" in
            -a|-aq|-qa) options=(-a) ;;
            -q) ;;
            *) echo "error: unsupported instance-list option: $arg" >&2; return 1 ;;
        esac
    done
    rows="$(docker ps --no-trunc "${options[@]}" --filter "label=c0dev.instance=$C0_INSTANCE_ID" \
        --format '{{printf "%s\t%s" .ID .Names}}')" || return 1
    while IFS=$'\t' read -r cid name; do
        [[ -n "$cid" ]] || continue
        [[ "$name" != "c0-recovery-${C0_INSTANCE_ID}-${cid}" ]] || continue
        printf '%s\n' "$cid"
    done <<<"$rows"
}

# Workspace discovery comes from Docker ownership, including pre-build-key
# runtimes. Backup artifacts are never primary runtimes.
c0_list_workspace_containers() {
    local rows cid name seen=$'\n' scope arg all=false
    for arg in "$@"; do case "$arg" in -a|-aq|-qa) all=true ;; -q) ;; *) return 1 ;; esac; done
    local -a options=()
    [[ "$all" != true ]] || options=(-a)
    for scope in "c0dev.workspace=${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}" "c0dev.instance=${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}"; do
        rows="$(docker ps --no-trunc "${options[@]}" --filter "label=$scope" \
            --format '{{printf "%s\t%s" .ID .Names}}')" || return 1
        while IFS=$'\t' read -r cid name; do
            [[ -n "$cid" ]] || continue
            [[ "$name" != c0-recovery-*-"$cid" ]] || continue
            [[ "$seen" != *$'\n'"$cid"$'\n'* ]] || continue
            seen+="$cid"$'\n'
            printf '%s\n' "$cid"
        done <<<"$rows"
    done
}

get_c0_container_id_any() {
    local ids cid selected=""
    ids="$(c0_list_instance_containers -aq)" || return 1
    if [[ -z "$ids" && "${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}" != "$C0_INSTANCE_ID" ]]; then
        ids="$(C0_INSTANCE_ID="$C0_WORKSPACE_ID" c0_list_instance_containers -aq)" || return 1
    fi
    if [[ -z "$ids" ]]; then
        ids="$(c0_list_workspace_containers -aq)" || return 1
    fi
    while IFS= read -r cid; do
        [[ -n "$cid" ]] || continue
        if [[ -n "$selected" ]]; then
            echo "error: multiple containers claim instance $C0_INSTANCE_ID; containers were left unchanged" >&2
            return 1
        fi
        selected="$cid"
    done <<<"$ids"
    [[ -z "$selected" ]] || printf '%s\n' "$selected"
    return 0
}

get_c0_container_state() {
    local cid="$1"
    [[ -z "$cid" ]] && return 0
    docker inspect -f '{{.State.Status}}' "$cid"
}

# Existing pre-keyed guests remain operable using their Docker identity. A
# missing published artifact never authorizes an empty replacement or a file
# based selection. New creation still requires a completed shared image.
c0_resolve_runtime_context() {
    local cid ids instance build mode recipe tools
    ids="$(c0_list_workspace_containers -aq)" || return 1
    if [[ "$ids" == *$'\n'* ]]; then
        ids="$(c0_list_workspace_containers -q)" || return 1
        if [[ -z "$ids" || "$ids" == *$'\n'* ]]; then
            echo 'error: multiple retained workspace containers; no container was selected or changed' >&2
            return 1
        fi
    fi
    cid="$ids"
    if [[ -n "$cid" ]]; then
        instance="$(docker inspect -f '{{ index .Config.Labels "c0dev.instance" }}' "$cid")" || return 1
        mode="$(docker inspect -f '{{ index .Config.Labels "c0dev.mode" }}' "$cid")" || return 1
        case "$mode" in ''|'<no value>') ;; *) [[ "$mode" == "$C0_MODE_KEY" ]] || return 1 ;; esac
        [[ "$instance" =~ ^c0dev(-dev)?-[0-9a-f]{8}$ ]] || return 1
        C0_INSTANCE_ID="$instance"
        build="$(docker inspect -f '{{ index .Config.Labels "c0dev.build" }}' "$cid")" || return 1
        if [[ "$build" =~ ^[0-9a-f]{64}$ ]]; then C0_BUILD_ID="$build"; fi
        recipe="$(docker inspect -f '{{ index .Config.Labels "c0dev.recipe" }}' "$cid")" || return 1
        if [[ "$recipe" =~ ^[0-9a-f]{64}$ ]]; then C0_RECIPE_ID="$recipe"; fi
        C0_RUNTIME_IMAGE="$(docker inspect -f '{{.Image}}' "$cid")" || return 1
        tools="$(get_tools_hash_label "$cid")" || return 1
        [[ "$tools" =~ ^[0-9a-f]{64}$ ]] || {
            echo "error: container $cid has no valid tools snapshot identity; existing data was retained" >&2; return 1;
        }
        set_tools_id "$tools" || return 1
        export C0_INSTANCE_ID C0_RUNTIME_IMAGE C0_BUILD_ID
        return 0
    fi
    c0_resolve_shared_build
}

get_c0_container_id() {
    local cid state
    cid="$(get_c0_container_id_any)" || return 1
    [[ -n "$cid" ]] || return 0
    state="$(get_c0_container_state "$cid")" || return 1
    [[ "$state" != running ]] || printf '%s\n' "$cid"
    return 0
}

get_c0_container_security_mode() {
    local cid="$1"
    [[ -z "$cid" ]] && return 0
    docker inspect "$cid" --format '{{ index .Config.Labels "c0dev.security_mode" }}' 2>/dev/null || true
}

get_running_container_security_mode() {
    local cid
    cid="$(get_c0_container_id)" || return 1
    [[ -z "$cid" ]] && return 0
    get_c0_container_security_mode "$cid"
}

# For dc and display when not starting: match running container, else env, else guest-admin.
ensure_c0_security_resolved() {
    if [[ -n "${C0_SECURITY_RESOLVED:-}" ]]; then
        return 0
    fi

    local from_container
    from_container="$(get_running_container_security_mode)"
    if [[ -n "$from_container" ]]; then
        # Older labels used these names for the guest-admin capability set.
        case "$from_container" in
            permissive|cap-drop-all) C0_SECURITY="guest-admin" ;;
            *)
                if ! validate_c0_security_value "$from_container"; then
                    return 1
                fi
                C0_SECURITY="$from_container"
                ;;
        esac
    elif [[ -n "${C0_SECURITY:-}" ]]; then
        if ! validate_c0_security_value "$C0_SECURITY"; then
            return 1
        fi
    else
        C0_SECURITY="guest-admin"
    fi
    export C0_SECURITY
}

# start/restart only: --least-privilege overrides env; default guest-admin.
resolve_c0_security_for_start() {
    local cli_least_privilege=false
    local arg
    for arg in "$@"; do
        case "$arg" in
            --least-privilege) cli_least_privilege=true ;;
            *)
                echo "error: unknown option: $arg (try --least-privilege)" >&2
                return 1
                ;;
        esac
    done

    if [[ "$cli_least_privilege" == true ]]; then
        C0_SECURITY="least-privilege"
    elif [[ -n "${C0_SECURITY:-}" ]]; then
        if ! validate_c0_security_value "$C0_SECURITY"; then
            return 1
        fi
    else
        C0_SECURITY="guest-admin"
    fi
    export C0_SECURITY
    export C0_SECURITY_RESOLVED=1
}

print_security_mode() {
    [[ "$IN_CONTAINER" != true ]] || return 0
    local cid="${1:-}" actual
    if [[ -z "$cid" ]]; then cid="$(get_c0_container_id)" || return 1; fi
    actual="$(get_c0_container_security_mode "$cid")"
    echo -e "🔒 Security: ${YELLOW}${actual:-unknown}${NC} (container label)"
}

# =============================================================================
# SSH agent: bind the OrbStack relay at the same guest path and set SSH_AUTH_SOCK.
# =============================================================================

# True when we should set guest SSH_AUTH_SOCK to the OrbStack fixed path.
c0_ssh_agent_enabled() {
    [[ "${C0_SSH_AGENT:-1}" == "0" ]] && return 1
    # Host should have an agent; OrbStack forwards it to C0_SSH_AUTH_SOCK_PATH in the VM.
    [[ -n "${SSH_AUTH_SOCK:-}" ]] || return 1
    return 0
}

ensure_ssh_auth_compose_fragment() {
    cat <<EOF
services:
  c0dev:
    environment:
      SSH_AUTH_SOCK: ${C0_SSH_AUTH_SOCK_PATH}
    volumes:
      - ${C0_SSH_AUTH_SOCK_PATH}:${C0_SSH_AUTH_SOCK_PATH}
EOF
}

print_ssh_auth_mapping() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi
    if c0_ssh_agent_enabled; then
        echo -e "🔑 SSH agent: ${YELLOW}${C0_SSH_AUTH_SOCK_PATH}${NC} (OrbStack relay; same-path socket bind)"
    fi
}

# =============================================================================
# Helper: docker-compose wrapper (one compose project per instance id)
# =============================================================================

c0_command_environment() {
    local action="$1" name assignment
    shift
    local -a environment=()
    # Only nonsecret launcher inputs belong here. Keep the same projection for
    # every Compose invocation and status; optional defaults remain in Compose.
    for name in C0_MODE_KEY C0_RECIPE_ID C0_WORKSPACE_ID C0_INSTANCE_ID \
        C0_BUILD_ID C0_RUNTIME_IMAGE SHARED_TOOLS_VOLUME TOOLS_ID TOOLS_PREFIX \
        C0DEV_WEB_PORT C0DEV_SSH_PORT C0_SECURITY C0_HOME_OVERLAYS_VOLUME \
        C0_HOME_OVERLAYS_EXTERNAL C0_BUILD_CONTEXT DOCKERFILE_RUNTIME_BUILD TERM; do
        environment+=("$name=${!name-}")
    done
    case "$action" in
        run)
            [[ $# -gt 0 ]] || { echo 'error: command environment requires a command' >&2; return 2; }
            env "${environment[@]}" "$@"
            ;;
        show)
            [[ $# -eq 0 ]] || { echo 'error: command environment display takes no arguments' >&2; return 2; }
            for assignment in "${environment[@]}"; do
                printf '  %s=%q\n' "${assignment%%=*}" "${assignment#*=}"
            done
            ;;
        *) echo 'error: invalid command environment operation' >&2; return 2 ;;
    esac
}

dc() {
    local -a compose_files=(
        -f "$VOLUMES_FOLDERS_FILE"
        -f "$VOLUMES_FILES_FILE"
        -f "$COMPOSE_PUBLIC_FILE"
    )
    # Creation settings cannot gate exec, logs, inspection, or teardown of an
    # existing container. Its security label is descriptive, not a prerequisite
    # for operating it. Only commands that create containers need the overlays.
    case "${1:-}" in
        up|create|run|config)
            ensure_c0_security_resolved || return 1
            local security_file
            security_file="$(c0_security_compose_file)" || return 1
            compose_files+=(-f "$security_file")
            ;;
    esac

    case "${1:-}" in
        up|create|run|config)
            if c0_ssh_agent_enabled; then
                c0_command_environment run docker compose -p "$C0_INSTANCE_ID" "${compose_files[@]}" \
                    -f <(ensure_ssh_auth_compose_fragment) "$@"
                return $?
            fi
            ;;
    esac
    c0_command_environment run docker compose -p "$C0_INSTANCE_ID" "${compose_files[@]}" "$@"
}

# Image construction does not use runtime security, ports, or SSH mounts. Keep
# it independent of running-container labels and avoid runtime setup helpers.
dc_build() {
    # Compose adds its project to image labels, so this project must have the
    # shared build identity rather than the working-folder runtime identity.
    c0_command_environment run docker compose -p "c0dev-build-${C0_MODE_KEY}-${C0_BUILD_ID}" \
        -f "$C0_BUILD_CONTEXT/runtime-image.yaml" \
        build "$@"
}

c0_base_image_matches() {
    local metadata
    metadata="$(docker image inspect --format '{{printf "%s\t%s\t%s" (index .Config.Labels "c0dev.mode") (index .Config.Labels "c0dev.recipe") (index .Config.Labels "c0dev.build")}}' "$C0_BASE_IMAGE" 2>/dev/null)" || return 1
    [[ "$metadata" == "$C0_MODE_KEY"$'\t'"${C0_BASE_RECIPE_ID:-$C0_RECIPE_ID}"$'\t'"${C0_BASE_BUILD_ID:-$C0_BUILD_ID}" ]]
}

c0_validate_base_image() {
    docker run --rm --pull=never --network none --read-only --cap-drop ALL \
        --security-opt no-new-privileges --user 1000:1000 --entrypoint /bin/bash \
        "$1" -c 'set -e; test "$(id -un)" = dev; bun --version >/dev/null; test -s "$SSL_CERT_FILE"'
}

c0_build_base_image() {
    local nocache="${1:-}"
    local staging="c0dev-base-${C0_MODE_KEY}-build:$(basename "$(dirname "$C0_BUILD_CONTEXT")")"
    if [[ -z "$nocache" ]] && c0_base_image_matches && c0_validate_base_image "$C0_BASE_IMAGE"; then
        echo '📦 Base: valid'
        return 0
    fi
    echo '🏗️  Building shared base image...'
    if ! docker build --pull $nocache "${C0_TOOLCHAIN_BUILD_ARGS[@]}" \
        --target base --label "c0dev.mode=$C0_MODE_KEY" \
        --label "c0dev.recipe=${C0_BASE_RECIPE_ID:-$C0_RECIPE_ID}" --label "c0dev.build=${C0_BASE_BUILD_ID:-$C0_BUILD_ID}" \
        -f "$DOCKERFILE_BASE" -t "$staging" "$C0_BUILD_CONTEXT"; then
        docker image rm "$staging" >/dev/null 2>&1 || true
        return 1
    fi
    if ! c0_validate_base_image "$staging"; then
        docker image rm "$staging" >/dev/null 2>&1 || true
        return 1
    fi
    docker image tag "$staging" "$C0_BASE_IMAGE" || return 1
    docker image rm "$staging" >/dev/null 2>&1 || true
}

c0_publish_runtime_image() {
    local image="$1" reference
    reference="$(c0_runtime_recipe_ref)" || return 1
    docker image inspect "$C0_BASE_IMAGE" >/dev/null || return 1
    docker image tag "$image" "$C0_RUNTIME_IMAGE" || return 1
    # Updating the shared recipe tag publishes the completed image to every
    # working folder; Docker supplies the previous image until this succeeds.
    docker image tag "$image" "$reference" || return 1
    docker image tag "$image" "c0dev-runtime-${C0_MODE_KEY}:current"
}

# Docker can retain a tag whose backing content has disappeared. Build privately
# and exercise the resulting immutable image before publishing the normal tag.
c0_docker_content_failure() {
    LC_ALL=C grep -Eiq 'content digest .*not found|blob.*not found|failed to get layer|parent snapshot.*does not exist|failed to (read|load cache key).*sha256.*not found' "$1"
}

c0_validate_runtime_image() {
    local image input reference="${1:-$C0_RUNTIME_BUILD_TAG}"
    local -a terminals=(xterm-256color)
    if [[ -d "${C0_BUILD_CONTEXT:-}/.terminfo" ]]; then
        terminals=()
        for input in "$C0_BUILD_CONTEXT/.terminfo/"*; do
            [[ -f "$input" && ! -L "$input" ]] || return 1
            terminals+=("${input##*/}")
        done
    fi
    image="$(docker image inspect --format '{{.Id}}' "$reference")" || return 1
    [[ "$image" =~ ^sha256:[0-9a-f]{64}$ ]] || {
        echo 'error: Docker returned an invalid built image identity' >&2; return 1;
    }
    docker run --rm --pull=never --network none --read-only --cap-drop ALL \
        --security-opt no-new-privileges --user 1000:1000 --entrypoint /bin/bash \
        "$image" -c '
            set -e
            test "$(id -u)" = 1000
            test "$(id -un)" = dev
            test -x /usr/local/bin/docker-entrypoint.sh
            /bin/bash -n /usr/local/bin/docker-entrypoint.sh
            test -x /usr/sbin/sshd
            /usr/sbin/sshd -V
            bun --version
            for terminal do infocmp -x "$terminal" >/dev/null; done
        ' c0-runtime-check "${terminals[@]}" || return 1
    printf '%s\n' "$image" >"$C0_BUILD_CONTEXT/.runtime-image-id"
}

c0_runtime_image_matches() {
    local metadata expected
    metadata="$(docker image inspect --format '{{printf "%s\t%s\t%s\t%s\t%s\t%s" (index .Config.Labels "c0dev.mode") (index .Config.Labels "c0dev.recipe") (index .Config.Labels "c0dev.build") (index .Config.Labels "c0dev.tools_hash") (index .Config.Labels "c0dev.tools_volume") (index .Config.Labels "c0dev.base_image")}}' "$C0_RUNTIME_IMAGE" 2>/dev/null)" || return 1
    expected="$C0_MODE_KEY"$'\t'"$C0_RECIPE_ID"$'\t'"$C0_BUILD_ID"$'\t'"$TOOLS_ID"$'\t'"$SHARED_TOOLS_VOLUME"$'\t'"$C0_BASE_IMAGE"
    [[ "$metadata" == "$expected" ]]
}

c0_build_runtime_image() {
    local nocache="${1:-}" attempt=0 status image log context_yaml dockerfile_yaml
    local C0_RUNTIME_BUILD_TAG="c0dev-runtime-${C0_MODE_KEY}-build:$(basename "$(dirname "$C0_BUILD_CONTEXT")")"
    log="$C0_BUILD_CONTEXT/runtime-build.log"
    if [[ -z "$nocache" ]] && c0_runtime_image_matches && c0_validate_runtime_image "$C0_RUNTIME_IMAGE" >"$log" 2>&1; then
        image="$(cat "$C0_BUILD_CONTEXT/.runtime-image-id")" || return 1
        c0_publish_runtime_image "$image" || return 1
        echo '📦 Image: valid'
        return 0
    fi
    # Compose reads only this owned construction descriptor. Runtime mappings,
    # ports and profiles are neither parsed nor allowed to override the build.
    context_yaml="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1].replace("$", "$$")))' "$C0_BUILD_CONTEXT")" || return 1
    dockerfile_yaml="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1].replace("$", "$$")))' "${DOCKERFILE_RUNTIME_BUILD:-$C0_BUILD_CONTEXT/Dockerfile.runtime.build}")" || return 1
    cat >"$C0_BUILD_CONTEXT/runtime-image.yaml" <<EOF
services:
  $MAIN_SERVICE:
    image: $C0_RUNTIME_BUILD_TAG
    build:
      context: $context_yaml
      dockerfile: $dockerfile_yaml
      labels:
        c0dev.mode: "$C0_MODE_KEY"
        c0dev.recipe: "$C0_RECIPE_ID"
        c0dev.build: "$C0_BUILD_ID"
        c0dev.tools_hash: "$TOOLS_ID"
        c0dev.tools_volume: "$SHARED_TOOLS_VOLUME"
        c0dev.base_image: "$C0_BASE_IMAGE"
EOF
    while :; do
        # Keep Docker attached to the caller's terminal for its normal progress
        # renderer. A pipe makes Compose select verbose plain output instead.
        if [[ -t 2 ]]; then
            : >"$log"
            if dc_build --pull $nocache "${C0_TOOLCHAIN_BUILD_ARGS[@]}" "$MAIN_SERVICE"; then
                status=0
            else
                status=$?
            fi
        else
            if dc_build --pull $nocache "${C0_TOOLCHAIN_BUILD_ARGS[@]}" "$MAIN_SERVICE" 2>&1 | tee "$log"; then
                status=${PIPESTATUS[0]}
            else
                status=${PIPESTATUS[0]}
            fi
        fi
        if [[ "$status" == 0 ]]; then
            if c0_validate_runtime_image >>"$log" 2>&1; then break; fi
            cat "$log" >&2
        fi
        if [[ "$attempt" == 0 && -z "$nocache" ]] && c0_docker_content_failure "$log"; then
            echo 'warning: Docker cached image content is incomplete; retrying without cache' >&2
            attempt=1
            nocache=--no-cache
            continue
        fi
        docker image rm "$C0_RUNTIME_BUILD_TAG" >/dev/null 2>&1 || true
        echo 'error: image build or validation failed; previous shared image retained' >&2
        return 1
    done
    image="$(cat "$C0_BUILD_CONTEXT/.runtime-image-id")" || return 1
    if ! c0_publish_runtime_image "$image"; then
        docker image rm "$C0_RUNTIME_BUILD_TAG" >/dev/null 2>&1 || true
        echo 'error: shared image publication failed; build did not complete' >&2
        return 1
    fi
    docker image rm "$C0_RUNTIME_BUILD_TAG" >/dev/null 2>&1 || true
}

# =============================================================================
# Helper functions
# =============================================================================

get_mapped_web_port_from_container() {
    local container_id="$1"
    docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if eq $p "3000/tcp"}}{{if $conf}}{{(index $conf 0).HostPort}}{{end}}{{end}}{{end}}' "$container_id" 2>/dev/null || true
}

get_current_web_port() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    local container_id
    container_id="$(get_c0_container_id_any)"
    if [[ -n "$container_id" ]]; then
        local mapped
        mapped="$(get_mapped_web_port_from_container "$container_id")"
        if [[ -n "$mapped" ]]; then
            echo "$mapped"
            return 0
        fi
    fi

    if [[ -n "${C0DEV_WEB_PORT:-}" ]]; then
        echo "$C0DEV_WEB_PORT"
        return 0
    fi
}

# Finds the first integer >= start that is not present in the provided set.
# Signature: first_gap_port <start> [ports...]
# Assumes the list is sorted ascending (as produced by bin/list-listening-ports).
first_gap_port() {
    local start="$1"
    shift

    local candidate="$start"
    local port
    for port in "$@"; do
        case "$port" in
            ''|*[!0-9]*) continue ;;
        esac

        if [[ "$port" -lt "$candidate" ]]; then
            continue
        fi
        if [[ "$port" -eq "$candidate" ]]; then
            candidate=$((candidate + 1))
            continue
        fi

        echo "$candidate"
        return 0
    done

    echo "$candidate"
    return 0
}

ensure_web_port() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    if [[ -n "${C0DEV_WEB_PORT:-}" ]]; then
        return 0
    fi

    local start="$C0DEV_WEB_PORT_MIN"
    local end="$C0DEV_WEB_PORT_MAX"
    local ports_cmd="$C0ROOT/bin/list-listening-ports"
    if [[ ! -x "$ports_cmd" ]]; then
        echo "error: missing required helper: $ports_cmd" >&2
        return 1
    fi

    local ports
    if ! ports="$("$ports_cmd" "$start" "$end")"; then
        return 1
    fi

    local next
    local -a port_list=()
    if [[ -n "$ports" ]]; then
        local line
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            port_list+=("$line")
        done <<<"$ports"
    fi

    next="$(first_gap_port "$start" "${port_list[@]}")"

    if [[ "$next" -gt "$end" ]]; then
        echo "error: no ports left in range ${start}-${end}" >&2
        return 1
    fi

    C0DEV_WEB_PORT="$next"
    export C0DEV_WEB_PORT
}

print_web_port_mapping() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    local port
    port="$(get_current_web_port || true)"
    if [[ -n "$port" ]]; then
        echo -e "🌐 Port: ${YELLOW}host:${port}${NC} -> ${YELLOW}guest:3000${NC}"
    fi
}

get_mapped_ssh_port_from_container() {
    local container_id="$1"
    docker inspect -f '{{range $p, $conf := .NetworkSettings.Ports}}{{if eq $p "2222/tcp"}}{{range $conf}}{{if eq .HostIp "127.0.0.1"}}{{.HostPort}}{{end}}{{end}}{{end}}{{end}}' "$container_id" 2>/dev/null || true
}

# Guest IPv4 as seen from the host (compose network). Empty if unknown.
get_c0_container_ip() {
    local container_id="${1:-}"
    [[ -z "$container_id" ]] && container_id="$(get_c0_container_id_any)"
    [[ -z "$container_id" ]] && return 0
    docker inspect -f '{{range .NetworkSettings.Networks}}{{if .IPAddress}}{{.IPAddress}}{{println}}{{end}}{{end}}' "$container_id" 2>/dev/null | awk 'NF { print; exit }'
}

# SSH remote shown in status/start output: user@<host-relative-ip>:2222
ssh_remote_display() {
    local ip
    ip="$(get_c0_container_ip "${1:-}")"
    echo "dev@${ip:-127.0.0.1}:2222"
}

# Orca advertised endpoint: <host-relative-ip>:6768 (same IP as ssh_remote_display)
orca_remote_display() {
    local ip
    ip="$(get_c0_container_ip "${1:-}")"
    [[ -n "$ip" ]] || return 0
    echo "${ip}:${C0DEV_ORCA_GUEST_PORT}"
}

get_current_ssh_port() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    local container_id
    container_id="$(get_c0_container_id_any)"
    if [[ -n "$container_id" ]]; then
        local mapped
        mapped="$(get_mapped_ssh_port_from_container "$container_id")"
        if [[ -n "$mapped" ]]; then
            echo "$mapped"
            return 0
        fi
    fi

    if [[ -n "${C0DEV_SSH_PORT:-}" ]]; then
        echo "$C0DEV_SSH_PORT"
        return 0
    fi
}

ensure_ssh_port() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    if [[ -n "${C0DEV_SSH_PORT:-}" ]]; then
        return 0
    fi

    local container_id
    container_id="$(c0_command_environment run docker compose -p "$C0_INSTANCE_ID" \
        -f "$VOLUMES_FOLDERS_FILE" -f "$VOLUMES_FILES_FILE" -f "$COMPOSE_PUBLIC_FILE" \
        ps -aq "$MAIN_SERVICE" 2>/dev/null | head -n 1 || true)"
    if [[ -n "$container_id" ]]; then
        local mapped
        mapped="$(get_mapped_ssh_port_from_container "$container_id")"
        if [[ -n "$mapped" ]]; then
            C0DEV_SSH_PORT="$mapped"
            export C0DEV_SSH_PORT
            return 0
        fi
    fi

    local start="$C0DEV_SSH_PORT_MIN"
    local end="$C0DEV_SSH_PORT_MAX"
    local ports_cmd="$C0ROOT/bin/list-listening-ports"
    if [[ ! -x "$ports_cmd" ]]; then
        echo "error: missing required helper: $ports_cmd" >&2
        return 1
    fi

    local ports
    if ! ports="$("$ports_cmd" "$start" "$end")"; then
        return 1
    fi

    local next
    local -a port_list=()
    if [[ -n "$ports" ]]; then
        local line
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            port_list+=("$line")
        done <<<"$ports"
    fi

    next="$(first_gap_port "$start" "${port_list[@]}")"

    if [[ "$next" -gt "$end" ]]; then
        echo "error: no SSH ports left in range ${start}-${end}" >&2
        return 1
    fi

    C0DEV_SSH_PORT="$next"
    export C0DEV_SSH_PORT
}

print_ssh_server_mapping() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi

    local port
    port="$(get_current_ssh_port || true)"
    if [[ -n "$port" ]]; then
        echo -e "🔐 SSH: ${YELLOW}127.0.0.1:${port}${NC} -> ${YELLOW}$(ssh_remote_display)${NC} (${CYAN}c0 ssh${NC})"
    fi
}

print_orca_endpoint() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi
    local ep
    ep="$(orca_remote_display)"
    if [[ -n "$ep" ]]; then
        echo -e "🐋 Orca: ${YELLOW}${ep}${NC} (${CYAN}c0 orca${NC})"
    fi
}

c0_host_io() {
    /usr/bin/python3 -I "${C0_HOST_IO:-$C0ROOT/bin/c0-host-io}" "$C0ROOT" "$@"
}

c0_credentials() {
    /usr/bin/python3 -I "$C0ROOT/bin/c0-credentials" "$C0ROOT" "$@"
}

c0_ssh_write_sshd_config() {
    local ssh_dir="$C0_SSH_DIR"
    # Only the private framed environment and ordinary locale are accepted.
    # Written on keygen/start (bind-mounted auth/ssh/); not rewritten on c0 ssh attach.
    c0_host_io write-config "$ssh_dir/sshd_config" <<EOF
Port 2222
ListenAddress 0.0.0.0
PermitTTY yes
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /home/dev/.ssh/authorized_keys
HostKey /home/dev/.ssh/ssh_host_ed25519_key
PidFile /home/dev/.ssh/sshd.pid
UsePAM no
LogLevel INFO
AcceptEnv C0_SESSION_ENV* LANG LC_*
SetEnv SSH_AUTH_SOCK=${C0_SSH_AUTH_SOCK_PATH}
X11Forwarding yes
EOF
}

c0_ssh_keygen() {
    c0_host_io prepare-ssh "$C0_SSH_DIR" "$C0_INSTANCE_ID" "${C0_SSH_CLIENT_DIR:-$C0ROOT/auth/ssh-client}" || return 1
    c0_ssh_write_sshd_config
}

c0_ssh_ensure_keys() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        return 0
    fi
    # Presence alone cannot prove the selected client is still authorized.
    # Reconcile held key material and authorization without rotating keys or
    # changing the running daemon. Existing server configuration stays intact.
    c0_host_io prepare-ssh "$C0_SSH_DIR" "$C0_INSTANCE_ID" "$C0_SSH_CLIENT_DIR" || return 1
    if [[ ! -f "$C0_SSH_DIR/sshd_config" ]]; then
        c0_ssh_write_sshd_config || return 1
    fi
    return 0
}

c0_container_log_tail() {
    local cid="$1" lines="${2:-30}"
    local name
    [[ -z "$cid" ]] && return 0
    name="$(docker inspect -f '{{.Name}}' "$cid" 2>/dev/null | sed 's|^/||')"
    [[ -z "$name" ]] && return 0
    docker logs "$name" 2>&1 | tail -n "$lines"
}

c0_require_container_running() {
    local state
    c0_require_docker || return 1
    c0_resolve_runtime_context || return 1
    C0_RUNTIME_CID="$(get_c0_container_id_any)" || return 1
    if [[ -z "$C0_RUNTIME_CID" ]]; then
        echo "error: container not running — run 'c0 start' first" >&2
        return 1
    fi
    state="$(get_c0_container_state "$C0_RUNTIME_CID")" || return 1
    if [[ "$state" != running ]]; then
        echo "error: container $C0_RUNTIME_CID is $state — run 'c0 start' first" >&2
        return 1
    fi
}

c0_wait_container_running() {
    local cid="$1" i state
    for i in $(seq 1 15); do
        state="$(get_c0_container_state "$cid")" || return 1
        [[ "$state" != running ]] || return 0
        [[ "$state" == created || "$state" == restarting ]] || break
        sleep 0.2
    done
    echo "error: container $cid did not become running (state: $state)" >&2
    return 1
}

c0_stop_instance() {
    local ids cid instance instances=$'\n' remaining storage volume
    local -a containers=()
    c0_require_docker || return 1
    ids="$(c0_list_workspace_containers -aq)" || return 1
    while IFS= read -r cid; do
        [[ -n "$cid" ]] || continue
        c0_validate_container_mounts "$cid" false true || return 1
        instance="$(docker inspect -f '{{ index .Config.Labels "c0dev.instance" }}' "$cid")" || return 1
        if [[ "$instances" == *$'\n'"$instance"$'\n'* ]]; then
            echo 'error: duplicate runtimes claim the same build/workspace; containers were left unchanged' >&2
            return 1
        fi
        instances+="$instance"$'\n'
        containers+=("$cid")
    done <<<"$ids"
    [[ ${#containers[@]} -gt 0 ]] || return 0
    # Volumes remain Docker objects. No registry is written before teardown.
    storage="$(c0_discover_home_storage)" || return 1
    storage="${storage%%$'\t'*}"
    for cid in "${containers[@]}"; do
        volume="$(c0_overlay_volume_for_container "$cid")" || return 1
        if [[ "$volume" != "$storage" ]]; then
            echo 'error: active and retained Docker storage conflict; containers and data were left unchanged for review' >&2
            return 1
        fi
    done
    docker stop "${containers[@]}" >/dev/null || return 1
    docker rm "${containers[@]}" >/dev/null || return 1
    remaining="$(c0_list_workspace_containers -aq)" || return 1
    if [[ -n "$remaining" ]]; then
        echo "error: workspace still has runtimes: $remaining" >&2
        return 1
    fi
}

c0_start_ready() {
    local cid="$1" allow_legacy="${2:-false}" state
    c0_wait_container_running "$cid" || return 1
    c0_validate_container_mounts "$cid" false "$allow_legacy" || return 1
    set_tools_id "$C0_CONTAINER_TOOLS_ID" || return 1
    c0_setup_home_overlays "$cid" "$C0_CONTAINER_LAYOUT" || return 1
    c0_validate_container_mounts "$cid" true "$allow_legacy" || return 1
    state="$(get_c0_container_state "$cid")" || return 1
    if [[ "$state" != running ]]; then
        echo "error: container $cid exited during initialization ($state)" >&2
        return 1
    fi
    c0_wait_runtime_ready "$cid" || return 1
}

c0_wait_runtime_ready() {
    local cid="$1" started attempt state
    started="$(docker inspect -f '{{.State.StartedAt}}' "$cid")" || return 1
    for attempt in $(seq 1 100); do
        state="$(get_c0_container_state "$cid")" || return 1
        [[ "$state" == running ]] || break
        if docker logs --since "$started" "$cid" 2>&1 | tr -d '\r' | grep -qx 'c0dev ready'; then
            if docker exec -u 1000 "$cid" sh -ec '
                if [ -s "$HOME/.ssh/authorized_keys" ] && [ -r "$HOME/.ssh/sshd_config" ]; then
                    nc -z -w 1 127.0.0.1 2222
                fi
            '; then
                return 0
            fi
        fi
        sleep 0.2
    done
    echo "error: container $cid did not complete startup; inspect its logs" >&2
    return 1
}

c0_warn_container_user() {
    local cid user
    cid="$(get_c0_container_id)"
    [[ -z "$cid" ]] && return 0
    user="$(docker inspect -f '{{.Config.User}}' "$cid" 2>/dev/null || true)"
    if [[ -n "$user" && "$user" != "dev" ]]; then
        echo -e "${YELLOW}warning:${NC} container User=${user} (expected dev, image USER); run 'c0 build' to refresh image" >&2
    fi
}

c0_validate_overlay_row() {
    local guest_rel="$1" tools_rel="$2" extra="${3:-}"
    if [[ -z "$guest_rel" || -z "$tools_rel" || -n "$extra" ||
          ! "$guest_rel" =~ ^\.[A-Za-z0-9._/-]+$ ||
          ! "$tools_rel" =~ ^\.[A-Za-z0-9._/-]+$ ||
          "$guest_rel" == *..* || "$tools_rel" == *..* ]]; then
        echo "error: invalid home overlay policy row: ${guest_rel}|${tools_rel}" >&2
        return 1
    fi
    return 0
}

c0_container_has_overlay_state_volume() {
    local cid="$1" rw
    rw="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/run/c0/overlay-state"}}{{.RW}}{{end}}{{end}}' "$cid" 2>/dev/null || true)"
    [[ "$rw" == true ]]
}

c0_mount_home_overlay() {
    local cid="$1" guest_rel="$2" tools_rel="$3"

    # The launcher has its own persistent upper, separate from tool snapshots.
    if [[ "$guest_rel" != bin || "$tools_rel" != /run/c0/host-bin ]]; then
        c0_validate_overlay_row "$guest_rel" "$tools_rel" || return 1
    fi

    docker run --rm \
        --network none \
        --read-only \
        --pid="container:$cid" \
        --cap-drop ALL \
        --cap-add SYS_ADMIN \
        --cap-add SYS_PTRACE \
        --cap-add SYS_CHROOT \
        --cap-add DAC_OVERRIDE \
        --cap-add DAC_READ_SEARCH \
        --cap-add CHOWN \
        --cap-add FOWNER \
        --security-opt seccomp=unconfined \
        --security-opt no-new-privileges:true \
        alpine /bin/sh -eu -c 'exec 3</; exec 4</proc; exec 5>/dev/null; exec "$@"' c0-helper-root \
        nsenter -t 1 -m --root=/proc/self/fd/3 --wd=/proc/self/fd/4 -- /bin/sh -eu -c '            exec 3<&-
            exec 4<&-
            guest_rel=$1
            tools_rel=$2
            tools_prefix=$3
            tools_id=$4
            # Executables and their dynamic loader remain in the read-only helper root.
            # Only data and mount targets are addressed through the target'"'"'s held proc root.
            guest_root=1/root
            name=${guest_rel#.}
            name=$(printf '"'"'%s'"'"' "$name" | tr '"'"'/'"'"' '"'"'-'"'"')
            target_guest="/home/dev/$guest_rel"
            lower_guest="$tools_prefix/$tools_rel"
            state_guest=/run/c0/overlay-state
            upper_guest="$state_guest/upper/$name"
            work_guest="$state_guest/work/$tools_id/$name"
            if [ "$guest_rel" = bin ]; then
                lower_guest=/run/c0/host-bin
                upper_guest="$state_guest/launcher/upper"
                work_guest="$state_guest/launcher/work"
            fi
            target="$guest_root$target_guest"
            lower="$guest_root$lower_guest"
            upper="$guest_root$upper_guest"
            work="$guest_root$work_guest"
            # Read kernel mount facts with helper-owned tools, never guest findmnt/PATH.
            mount_fact() {
                awk -v path="$1" -v field="$2" '"'"'
                    $5 == path || (substr(path,1,length($5)+1) == $5 "/") {
                        if (length($5) >= longest) {
                            longest=length($5); options=$6; type=""
                            for (i=7;i<=NF;i++) if ($i == "-") { type=$(i+1); break }
                        }
                    }
                    END { if (field == "type") print type; else print options }
                '"'"' 1/mountinfo
            }
            case ",$(mount_fact "$lower_guest" options)," in
                *,ro,*) ;;
                *) echo '"'"'error: overlay lower must be read-only'"'"' >&2; exit 1 ;;
            esac
            [ -d "$lower" ] && [ ! -L "$lower" ] || {
                echo '"'"'error: unsafe or missing overlay lower'"'"' >&2; exit 1;
            }
            [ -d "$guest_root$state_guest" ] && [ ! -L "$guest_root$state_guest" ] || {
                echo '"'"'error: unsafe or missing overlay state'"'"' >&2; exit 1;
            }
            # Refuse redirected control ancestors before privileged mkdir/chown/mount.
            for path in "$state_guest/upper" "$state_guest/work" "$state_guest/work/$tools_id"             "$state_guest/launcher" "$upper_guest" "$work_guest"; do
                [ ! -L "$guest_root$path" ] || {
                    echo '"'"'error: redirected overlay state path'"'"' >&2; exit 1;
                }
            done
            mkdir -p "$upper" "$work"
            chown 1000:1000 "$upper"
            chmod 0700 "$upper"
            [ "$(stat -c %d "$upper")" = "$(stat -c %d "$work")" ] || {
                echo '"'"'error: overlay upper and work are on different filesystems'"'"' >&2; exit 1;
            }
            if [ -L "$target" ]; then
                old_target=$(readlink "$target")
                case "$old_target" in
                    "$tools_prefix"/*) rm "$target" ;;
                    *) echo '"'"'error: refusing unexpected overlay target symlink'"'"' >&2; exit 1 ;;
                esac
            fi
            if mountpoint -q "$target" 2>&5; then
                [ "$(mount_fact "$target_guest" type)" = overlay ] || {
                    echo '"'"'error: non-overlay mount already covers target'"'"' >&2; exit 1;
                }
                exit 0
            fi
            if [ -d "$target" ] && [ -n "$(find "$target" -mindepth 1 -maxdepth 1 -print -quit)" ]; then
                echo '"'"'error: refusing to cover non-empty overlay target'"'"' >&2; exit 1
            fi
            mkdir -p "$target"
            chown 1000:1000 "$target"
            mount -t overlay overlay     -o "rw,lowerdir=$lower,upperdir=$upper,workdir=$work,userxattr,index=off,metacopy=off,redirect_dir=nofollow"     "$target"' c0-overlay-mount "$guest_rel" "$tools_rel" "$TOOLS_PREFIX" "$TOOLS_ID"
}

c0_setup_home_overlays() {
    local cid="$1" layout="${2:-current}" guest_rel tools_rel extra

    if ! c0_container_has_overlay_state_volume "$cid"; then
        echo "error: container lacks its writable home-overlays volume; existing data was retained" >&2
        return 1
    fi

    # Host launchers remain the lower layer; guest changes never write through.
    if [[ "$layout" != legacy ]]; then
        c0_mount_home_overlay "$cid" bin /run/c0/host-bin || return 1
    fi

    while IFS='|' read -r guest_rel tools_rel extra; do
        case "$guest_rel" in
            ''|'#'*) continue ;;
        esac
        c0_validate_overlay_row "$guest_rel" "$tools_rel" "$extra" || return 1
        if ! c0_mount_home_overlay "$cid" "$guest_rel" "$tools_rel"; then
            echo "error: failed to mount home overlay for $guest_rel" >&2
            return 1
        fi
    done <"$HOME_OVERLAYS_FILE"
}

c0_overlay_name() {
    printf '%s' "${1#.}" | tr '/' '-'
}

c0_home_overlay_porcelain() {
    local cid="$1"
    docker exec -u 1000 "$cid" /usr/local/bin/c0-overlay-check --porcelain
}

# Snapshot the merged home-overlay targets while the runtime is paused. The
# helper joins only the runtime mount namespace, has no network, and writes the
# archive to stdout; it never receives tools-volume write access.
c0_snapshot_home_overlays() {
    local cid="$1" snapshot_dir="$2"
    local guest_rel tools_rel extra name archive member failed=0

    if ! docker pause "$cid" >/dev/null; then
        echo "error: failed to pause runtime for a consistent tools snapshot" >&2
        return 1
    fi
    trap 'docker unpause "$cid" >/dev/null 2>&1 || true; rm -rf "$snapshot_dir"; exit 130' INT TERM

    while IFS='|' read -r guest_rel tools_rel extra; do
        case "$guest_rel" in
            ''|'#'*) continue ;;
        esac
        if ! c0_validate_overlay_row "$guest_rel" "$tools_rel" "$extra"; then
            failed=1
            break
        fi
        if [[ "$guest_rel" != "$tools_rel" ]]; then
            echo "error: tools accept requires identical guest and tools paths: ${guest_rel}|${tools_rel}" >&2
            failed=1
            break
        fi

        name="$(c0_overlay_name "$guest_rel")"
        archive="$snapshot_dir/${name}.tar"
        if ! docker run --rm \
            --network none \
            --read-only \
            --user 0:0 \
            --pid="container:$cid" \
            --cap-drop ALL \
            --cap-add SYS_ADMIN \
            --cap-add SYS_PTRACE \
            --cap-add SYS_CHROOT \
            --cap-add DAC_OVERRIDE \
            --cap-add DAC_READ_SEARCH \
            --security-opt seccomp=unconfined \
            --security-opt no-new-privileges:true \
            --entrypoint /bin/sh "$C0_TOOLS_HELPER_IMAGE" -eu -c \
            'exec 3</; exec 4</proc; exec "$@"' c0-snapshot-helper \
            /usr/bin/nsenter -t 1 -m --root=/proc/self/fd/3 --wd=/proc/self/fd/4 -- \
            /bin/sh -eu -c 'exec 3<&-; exec 4<&-; exec "$@"' c0-snapshot-tar \
            /bin/tar --xattrs --xattrs-include='*' --acls --numeric-owner \
                -C 1/root/home/dev -cf - "$guest_rel" \
            >"$archive"; then
            echo "error: failed to snapshot $guest_rel" >&2
            failed=1
            break
        fi

        while IFS= read -r member; do
            case "$member" in
                "$guest_rel"|"$guest_rel/"*) ;;
                *)
                    echo "error: snapshot contains path outside $guest_rel: $member" >&2
                    failed=1
                    break
                    ;;
            esac
        done < <(tar -tf "$archive")
        [[ "$failed" -eq 0 ]] || break
        printf '%s|%s|%s\n' "$guest_rel" "$tools_rel" "${name}.tar" >>"$snapshot_dir/policy"
    done <"$HOME_OVERLAYS_FILE"

    if ! docker unpause "$cid" >/dev/null; then
        trap - INT TERM
        echo "error: failed to resume runtime after tools snapshot" >&2
        return 1
    fi
    trap - INT TERM
    [[ "$failed" -eq 0 ]]
}

c0_publish_home_overlay_snapshot() {
    local snapshot_dir="$1" parent_id="$2" accepted_id="$3" stage_sha="$4"

    c0_docker_run \
        --network none \
        --read-only \
        --user 0:0 \
        --cap-add CHOWN \
        --cap-add DAC_OVERRIDE \
        --cap-add DAC_READ_SEARCH \
        --cap-add FOWNER \
        -v "$SHARED_TOOLS_VOLUME:/tools" \
        -v "$snapshot_dir:/snapshot:ro" \
        --entrypoint /bin/sh "$C0_TOOLS_HELPER_IMAGE" -eu -c '
            parent_id=$1
            accepted_id=$2
            stage_sha=$3
            candidate="/tools/tmp/${accepted_id}.partial"
            target="/tools/opt/${accepted_id}"

            if [ -f "$target/.c0dev-complete" ]; then
                exit 0
            fi
            [ -f "/tools/opt/${parent_id}/.c0dev-complete" ] || {
                echo "error: selected tools snapshot is incomplete" >&2
                exit 1
            }

            mkdir -p /tools/tmp /tools/opt
            rm -rf "$candidate"
            /bin/cp -dR --preserve=mode,ownership,timestamps,links,xattr "/tools/opt/${parent_id}" "$candidate"
            rm -f "$candidate/.c0dev-complete"

            while IFS="|" read -r guest_rel tools_rel archive; do
                [ -n "$guest_rel" ] || continue
                [ "$guest_rel" = "$tools_rel" ] || {
                    echo "error: unsupported overlay mapping: ${guest_rel}|${tools_rel}" >&2
                    exit 1
                }
                case "$tools_rel" in
                    .[A-Za-z0-9._/-]*) ;;
                    *)
                        echo "error: invalid tools path: $tools_rel" >&2
                        exit 1
                        ;;
                esac
                case "$tools_rel" in *..*) echo "error: invalid tools path: $tools_rel" >&2; exit 1 ;; esac
                rm -rf "$candidate/$tools_rel"
                /bin/tar --xattrs --xattrs-include="*" --acls --numeric-owner \
                    -C "$candidate" -xf "/snapshot/$archive"
            done </snapshot/policy

            printf "%s\n" "$parent_id" >"$candidate/.c0dev-accepted-from"
            printf "%s\n" "$stage_sha" >"$candidate/.c0dev-stage-sha256"
            chown -R 1000:1000 "$candidate"
            touch "$candidate/.c0dev-complete"
            chown 1000:1000 "$candidate/.c0dev-complete"

            if [ -e "$target" ]; then
                echo "error: refusing to replace existing incomplete tools snapshot: $target" >&2
                exit 1
            fi
            mv "$candidate" "$target"
        ' c0-tools-publisher "$parent_id" "$accepted_id" "$stage_sha"
}

c0_tools_helper_image() {
    local reference image
    reference="$(dc config --images)" || return 1
    [[ -n "$reference" && "$reference" != *$'\n'* ]] || {
        echo "error: tools preservation requires one built runtime image" >&2; return 1;
    }
    image="$(docker image inspect --format '{{.Id}}' "$reference")" || return 1
    [[ "$image" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$image"
}

# Storage identity is independent of toolchain selection and container lifetime.
c0_validate_overlay_volume() {
    local volume="$1" generation owner canonical="${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}-home-overlays"
    if [[ "$volume" == "$canonical" ]]; then return 0; fi
    generation="${volume#"${canonical}-"}"
    if [[ "$generation" == "$volume" || ! "$generation" =~ ^[0-9a-f]{32}$ ]]; then
        echo "error: invalid home-overlay volume at /run/c0/overlay-state for this checkout" >&2
        return 1
    fi
    owner="$(docker volume inspect -f '{{ index .Labels "c0dev.instance" }}' "$volume")" || return 1
    [[ "$owner" == "${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}" ]] || {
        echo "error: home-overlay volume belongs to another checkout" >&2; return 1;
    }
    owner="$(docker volume inspect -f '{{ index .Labels "c0dev.overlay_generation" }}' "$volume")" || return 1
    [[ "$owner" == "$generation" ]] || {
        echo "error: home-overlay generation metadata does not match its volume" >&2; return 1;
    }
}

c0_overlay_volume_for_container() {
    local volume
    volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/run/c0/overlay-state"}}{{if eq .Type "volume"}}{{.Name}}{{end}}{{end}}{{end}}' "$1")" || return 1
    c0_validate_overlay_volume "$volume" || return 1
    printf '%s\n' "$volume"
}

# A legacy volume's existing lineage labels are Docker state, not a mutable
# selector. Only an unambiguous leaf can be reused; timestamps are irrelevant.
c0_discover_home_storage() {
    local workspace="${C0_WORKSPACE_ID:-$C0_INSTANCE_ID}"
    local canonical="$workspace-home-overlays" names volume source candidates=$'\n' parents=$'\n' selected=""
    names="$(docker volume ls --filter "name=$canonical" --format '{{.Name}}')" || return 1
    while IFS= read -r volume; do
        [[ -n "$volume" ]] || continue
        if [[ "$volume" != "$canonical" && ! "$volume" =~ ^${canonical}-[0-9a-f]{32}$ ]]; then continue; fi
        c0_validate_overlay_volume "$volume" || return 1
        candidates+="$volume"$'\n'
        if [[ "$volume" != "$canonical" ]]; then
            source="$(docker volume inspect -f '{{ index .Labels "c0dev.overlay_source" }}' "$volume")" || return 1
            case "$source" in ''|'<no value>') ;; *) parents+="$source"$'\n' ;; esac
        fi
    done <<<"$names"
    while IFS= read -r volume; do
        [[ -n "$volume" ]] || continue
        [[ "$parents" != *$'\n'"$volume"$'\n'* ]] || continue
        if [[ -n "$selected" ]]; then
            echo 'error: Docker contains ambiguous home storage; no volume was changed or selected by recency' >&2
            return 1
        fi
        selected="$volume"
    done <<<"$candidates"
    if [[ -z "$selected" ]]; then
        [[ "$candidates" == $'\n' ]] || { echo 'error: invalid home-volume lineage in Docker' >&2; return 1; }
        printf '%s\tfalse\n' "$canonical"
    else
        printf '%s\ttrue\n' "$selected"
    fi
}

cmd_ssh() {
    require_host "ssh"

    if [[ "${1:-}" == "--keygen" ]]; then
        c0_ssh_keygen
        echo -e "✅ SSH keys: ${GREEN}auth/ssh/ (guest), auth/ssh-client/ (host)${NC}"
        return 0
    fi

    local trusted_x11=false
    if [[ "${1:-}" == "-Y" ]]; then
        trusted_x11=true
        shift
        if [[ "${1:-}" == "--" ]]; then
            shift
        fi
    fi

    c0_ssh_ensure_keys
    c0_require_container_running || exit 1
    "$C0ROOT/bin/c0-terminfo" sync "$C0_RUNTIME_CID" || return 1

    local port project_path
    port="$(get_current_ssh_port || true)"
    if [[ -z "$port" ]]; then
        echo "error: SSH port unknown — run 'c0 start' first" >&2
        exit 1
    fi

    project_path=$(get_project_path)

    local x11=0
    if [[ "$trusted_x11" == true ]]; then
        x11=1
        if [[ -z "${DISPLAY:-}" ]]; then
            echo "warning: DISPLAY is unset; start an X server on the host before using c0 ssh -Y" >&2
        fi
    fi
    # OpenSSH joins remote argv with spaces before the user shell runs
    # them. Pass a *single* remote-command string so `cd … && …` is not
    # split into `/bin/bash -lc cd … && …` (which cds in a nested shell
    # and leaves the outer pwd unchanged).
    #
    # One arg: treat as a shell script (ssh host 'cmd && cmd').
    # Several args: %q-join like a remote argv list (ssh host ls -la).
    local remote_script user_cmd
    if [[ $# -gt 0 ]]; then
        if [[ $# -eq 1 ]]; then
            user_cmd="$1"
        else
            user_cmd="$(printf '%q ' "$@")"
        fi
        if [[ -n "$project_path" ]]; then
            remote_script="cd $(printf '%q' "$CONTAINER_DEV_HOME/projects/$project_path") && ${user_cmd}"
        else
            remote_script="${user_cmd}"
        fi
        c0_credentials ssh "$C0_AUTH_ENV_FILE" "$C0_SSH_CLIENT_DIR" "$port" "$x11" 0 "$remote_script"
    elif [[ -n "$project_path" ]]; then
        print_web_port_mapping
        echo -e "🔐 SSH: ${CYAN}$MAIN_SERVICE${NC} (dev) @ ${YELLOW}projects/$project_path${NC}"
        remote_script="cd $(printf '%q' "$CONTAINER_DEV_HOME/projects/$project_path") && exec bash -l"
        c0_credentials ssh "$C0_AUTH_ENV_FILE" "$C0_SSH_CLIENT_DIR" "$port" "$x11" 1 "$remote_script"
    else
        remote_script="exec bash -l"
        c0_credentials ssh "$C0_AUTH_ENV_FILE" "$C0_SSH_CLIENT_DIR" "$port" "$x11" 1 "$remote_script"
    fi
}

cmd_orca() {
    require_host "orca"

    case "${1:-}" in
        --help|-h)
            cat <<EOF
Usage: c0 orca [start|stop|status]

  c0 orca         Status (not start).
  c0 orca start   Start guest \`orca serve\` in the background; print Orca's own URLs.
  c0 orca stop    Stop guest orca serve.
  c0 orca status  Same as c0 orca.

  ELECTRON_DISABLE_SANDBOX=1 orca serve --port ${C0DEV_ORCA_GUEST_PORT} --pairing-address <compose-ipv4> --project-root ${CONTAINER_DEV_HOME}/projects

Host reaches serve at compose-ipv4:${C0DEV_ORCA_GUEST_PORT} (same IP as c0 ssh's dev@ip:2222). No host port publish.
EOF
            return 0
            ;;
        ""|status) cmd_orca_status ;;
        start) shift; cmd_orca_start "$@" ;;
        stop) cmd_orca_stop ;;
        *)
            echo "error: usage: c0 orca [start|stop|status]" >&2
            exit 1
            ;;
    esac
}

c0_orca_ssh() {
    local remote_script="$1"
    local ssh_port
    ssh_port="$(get_current_ssh_port || true)"
    if [[ -z "$ssh_port" ]]; then
        echo "error: SSH port unknown — run 'c0 start' first" >&2
        return 1
    fi

    local auth="$C0_AUTH_ENV_FILE"
    [[ "${2:-}" != none ]] || auth=""
    c0_credentials ssh-batch "$auth" "$C0_SSH_CLIENT_DIR" "$ssh_port" 0 0 "$remote_script"
}

c0_orca_guest_listening() {
    c0_orca_ssh "nc -z -w 1 127.0.0.1 ${C0DEV_ORCA_GUEST_PORT}" none >/dev/null 2>&1
}

c0_orca_print_serve_output() {
    c0_host_io read-log "$C0_ORCA_LOG_HOST"
}

c0_orca_wait_for_urls() {
    if ! c0_host_io wait-log "$C0_ORCA_LOG_HOST"; then
        echo "error: orca serve did not provide safe Pairing URL output on $(orca_remote_display)" >&2
        return 1
    fi
}

cmd_orca_status() {
    c0_ssh_ensure_keys
    c0_require_container_running || exit 1
    print_orca_endpoint
    if c0_orca_guest_listening; then
        echo -e "   serve: ${GREEN}running${NC}"
        c0_orca_print_serve_output
        return 0
    fi
    echo -e "   serve: ${YELLOW}stopped${NC} (${CYAN}c0 orca start${NC})"
    return 1
}

cmd_orca_start() {
    c0_ssh_ensure_keys
    c0_require_container_running || exit 1

    local ip extra remote_script
    ip="$(get_c0_container_ip)"
    if [[ -z "$ip" ]]; then
        echo "error: guest IPv4 unknown" >&2
        exit 1
    fi

    extra=""
    if [[ $# -gt 0 ]]; then
        extra="$(printf '%q ' "$@")"
    fi

    print_orca_endpoint
    echo "   ELECTRON_DISABLE_SANDBOX=1 orca serve --port ${C0DEV_ORCA_GUEST_PORT} --pairing-address ${ip} --project-root ${CONTAINER_DEV_HOME}/projects"

    if c0_orca_guest_listening; then
        echo -e "   serve: ${GREEN}already running${NC}"
        c0_orca_print_serve_output
        return 0
    fi

    c0_host_io reset-log "$C0_ORCA_LOG_HOST" || return 1

    remote_script="$(cat <<EOF
set -euo pipefail
if [ -f "\$HOME/bin/activate" ]; then
  . "\$HOME/bin/activate"
fi
if ! command -v orca >/dev/null 2>&1; then
  echo "error: orca CLI is not on PATH in the guest (need \`orca serve\`, not orca-ide)" >&2
  exit 1
fi
mkdir -p "\$HOME/.local-rw"
cd $(printf '%q' "${CONTAINER_DEV_HOME}/projects")
set +m
nohup env ELECTRON_DISABLE_SANDBOX=1 orca serve --port ${C0DEV_ORCA_GUEST_PORT} --pairing-address $(printf '%q' "$ip") --project-root $(printf '%q' "${CONTAINER_DEV_HOME}/projects") ${extra} >>$(printf '%q' "$C0_ORCA_LOG_GUEST") 2>&1 </dev/null &
echo \$! > $(printf '%q' "$C0_ORCA_PID_GUEST")
disown || true
EOF
)"
    if ! c0_orca_ssh "$remote_script"; then
        echo "error: failed to launch orca serve in the guest" >&2
        exit 1
    fi

    c0_orca_wait_for_urls
}

cmd_orca_stop() {
    c0_ssh_ensure_keys
    c0_require_container_running || exit 1

    local remote_script
    remote_script="$(cat <<EOF
set +e
pidfile=$(printf '%q' "$C0_ORCA_PID_GUEST")
if [ -f "\$pidfile" ]; then
  pid=\$(cat "\$pidfile" 2>/dev/null)
  if [ -n "\$pid" ] && kill -0 "\$pid" 2>/dev/null; then
    kill "\$pid" 2>/dev/null
    i=0
    while kill -0 "\$pid" 2>/dev/null && [ "\$i" -lt 25 ]; do
      sleep 0.2
      i=\$((i + 1))
    done
    kill -9 "\$pid" 2>/dev/null
  fi
  rm -f "\$pidfile"
fi
pkill -f 'serve --port ${C0DEV_ORCA_GUEST_PORT}' 2>/dev/null
pkill -f 'serve-port ${C0DEV_ORCA_GUEST_PORT}' 2>/dev/null
pkill -f '${CONTAINER_DEV_HOME}/.local/opt/Orca/orca-ide' 2>/dev/null
exit 0
EOF
)"

    c0_orca_ssh "$remote_script" none || true

    local n=0
    while c0_orca_guest_listening; do
        n=$((n + 1))
        if [[ "$n" -gt 20 ]]; then
            echo "error: orca still listening on $(orca_remote_display)" >&2
            exit 1
        fi
        sleep 0.25
    done
    echo -e "🐋 Orca: ${YELLOW}stopped${NC}"
}

# Resolve a host path from a docker volume mapping into an absolute path.
resolve_volume_host_path() {
    local host_path="$1"
    local abs_host_path="$host_path"

    if [[ "$abs_host_path" == "~" ]]; then
        abs_host_path="$HOME"
    elif [[ "$abs_host_path" == "~/"* ]]; then
        abs_host_path="$HOME/${abs_host_path:2}"
    fi

    if [[ "$abs_host_path" =~ ^\.\. ]]; then
        abs_host_path="$C0ROOT/${abs_host_path#../}"
    elif [[ "$abs_host_path" =~ ^\. ]]; then
        abs_host_path="$C0ROOT/docker/${abs_host_path#./}"
    fi

    echo "$abs_host_path"
}

# Check if path looks like a docker volume name (not a host path)
is_docker_volume() {
    local path="$1"
    # Docker volumes don't start with /, ~, or .
    [[ ! "$path" =~ ^[/~.] ]]
}

# Convert absolute path to display path relative to C0ROOT
to_display_path() {
    local abs_path="$1"
    if [[ "$abs_path" == "$C0ROOT"/* ]]; then
        echo ".${abs_path#$C0ROOT}"
    elif [[ "$abs_path" == "$HOME"/* ]]; then
        echo "~${abs_path#$HOME}"
    else
        echo "$abs_path"
    fi
}

# Parse volumes-folders.yaml for folder mappings
# Calls callback: callback_func "$abs_host_path" "$container_path" "folder" "$display_host_path" "$ro"
parse_folder_mappings() {
    local callback_func="$1"
    local in_folders=false

    while IFS= read -r line; do
        if [[ "$line" =~ ^x-volume-folders:[[:space:]]*\&folders ]]; then
            in_folders=true
            continue
        fi

        if [[ "$in_folders" == true && "$line" =~ ^[^[:space:]#] ]]; then
            in_folders=false
        fi

        if [[ "$in_folders" == true && "$line" =~ ^[[:space:]]+-[[:space:]]*(.+)$ ]]; then
            local volume_line="${BASH_REMATCH[1]}"
            volume_line=$(echo "$volume_line" | sed 's/#.*//')
            volume_line=$(echo "$volume_line" | xargs)
            [[ -z "$volume_line" ]] && continue

            if [[ "$volume_line" == "type: volume" ]]; then
                local tools_display="tools-shared[selected snapshot unknown]"
                if [[ -n "$TOOLS_ID" ]]; then
                    tools_display="tools-shared[opt/${TOOLS_ID}]"
                fi
                "$callback_func" "" "/tools/current" "docker-volume" \
                    "$tools_display" "ro"
                continue
            fi

            local host_path container_path ro
            # Parse host:container or host:container:ro
            IFS=':' read -r host_path container_path ro <<< "$volume_line"

            if is_docker_volume "$host_path"; then
                # Docker volume, not a host path
                "$callback_func" "" "$container_path" "docker-volume" "$host_path" "$ro"
            else
                local abs_host_path display_path
                abs_host_path="$(resolve_volume_host_path "$host_path")"
                display_path="$(to_display_path "$abs_host_path")"
                "$callback_func" "$abs_host_path" "$container_path" "host-dir" "$display_path" "$ro"
            fi
        fi
    done < "$VOLUMES_FOLDERS_FILE"
}

# Parse volumes-files.yaml for file mappings
# Calls callback: callback_func "$abs_host_path" "$container_path" "file" "$display_host_path" "$ro"
parse_file_mappings() {
    local callback_func="$1"
    local in_files=false

    while IFS= read -r line; do
        if [[ "$line" =~ ^x-volume-files:[[:space:]]*\&files ]]; then
            in_files=true
            continue
        fi

        if [[ "$in_files" == true && "$line" =~ ^[^[:space:]#] ]]; then
            break
        fi

        if [[ "$in_files" == true && "$line" =~ ^[[:space:]]+-[[:space:]]*(.+)$ ]]; then
            local volume_line="${BASH_REMATCH[1]}"
            volume_line=$(echo "$volume_line" | sed 's/#.*//')
            volume_line=$(echo "$volume_line" | xargs)
            [[ -z "$volume_line" ]] && continue

            local host_path container_path ro
            IFS=':' read -r host_path container_path ro <<< "$volume_line"

            if is_docker_volume "$host_path"; then
                "$callback_func" "" "$container_path" "docker-volume" "$host_path" "$ro"
            else
                local abs_host_path display_path
                abs_host_path="$(resolve_volume_host_path "$host_path")"
                display_path="$(to_display_path "$abs_host_path")"
                "$callback_func" "$abs_host_path" "$container_path" "host-file" "$display_path" "$ro"
            fi
        fi
    done < "$VOLUMES_FILES_FILE"
}

# Validate the declared bind/volume contract using Docker metadata. This does
# not create a helper container, mount anything, or validate a different image.
c0_validate_container_mounts() {
    local cid="$1" check_guest="${2:-false}" allow_legacy="${3:-false}"
    local mounts tools_id subpath errors=0 layout=current
    local actual_type actual_source actual_target actual_rw actual_name seen_targets=$'\n'
    local old_bin=0 new_bin=0 old_git=0 old_bin_valid=false old_git_valid=false
    local expected_targets=$'\n' relay="${C0_SSH_AUTH_SOCK_PATH:-/run/host-services/ssh-auth.sock}"
    local -a guest_checks=() private_sources=() control_sources=()
    local host_bin_source host_git_source
    local expected_overlay contract host target kind display readonly protected source protected_source
    expected_overlay="$(c0_overlay_volume_for_container "$cid")" || return 1
    C0_CONTAINER_LAYOUT=""
    C0_CONTAINER_TOOLS_ID=""
    mounts="$(docker inspect -f '{{range .Mounts}}{{printf "%s\t%s\t%s\t%t\t%s\n" .Type .Source .Destination .RW .Name}}{{end}}' "$cid")" || return 1
    tools_id="$(get_tools_hash_label "$cid")"
    if [[ ! "$tools_id" =~ ^[0-9a-f]{64}$ ]]; then
        echo "error: container $cid has no valid tools snapshot identity; existing data was retained" >&2
        return 1
    fi

    # Recognize the complete previous contract, not an arbitrary invalid mount
    # set. Sources are still checked against this checkout below.
    for protected in "$C0ROOT/auth/ssh-client" "$C0ROOT/auth/.env"; do
        private_sources+=("$protected" "$(realpath "$protected" 2>/dev/null || printf '%s' "$protected")")
    done
    for protected in "$C0ROOT/bin" "$C0ROOT/docker" "$HOME/.gitconfig"; do
        control_sources+=("$protected" "$(realpath "$protected" 2>/dev/null || printf '%s' "$protected")")
    done
    host_bin_source="$(realpath "$C0ROOT/bin" 2>/dev/null || printf '%s' "$C0ROOT/bin")"
    host_git_source="$(realpath "$HOME/.gitconfig" 2>/dev/null || printf '%s' "$HOME/.gitconfig")"
    while IFS=$'\t' read -r actual_type actual_source actual_target actual_rw actual_name; do
        [[ -n "$actual_target" ]] || continue
        if [[ "$seen_targets" == *$'\n'"$actual_target"$'\n'* ]]; then
            echo "error: duplicate container mount at $actual_target" >&2
            errors=$((errors + 1))
        fi
        seen_targets+="$actual_target"$'\n'
        case "$actual_target" in
            /home/dev/bin)
                old_bin=$((old_bin + 1))
                [[ "$actual_type" != bind || "$actual_rw" != true ]] || old_bin_valid=true
                ;;
            /run/c0/host-bin) new_bin=$((new_bin + 1)) ;;
            /home/dev/.gitconfig)
                old_git=$((old_git + 1))
                [[ "$actual_type" != bind || "$actual_rw" != true ]] || old_git_valid=true
                ;;
        esac
    done <<<"$mounts"
    if [[ "$allow_legacy" == true && "$old_bin" -eq 1 && "$new_bin" -eq 0 &&
          "$old_git" -eq 1 && "$old_bin_valid" == true && "$old_git_valid" == true ]]; then
        layout=legacy
    fi

    # A harmless destination name does not make a host source harmless. Check
    # every recorded bind for aliases/ancestors of protected host authority.
    while IFS=$'\t' read -r actual_type actual_source actual_target actual_rw actual_name; do
        [[ "$actual_type" == bind ]] || continue
        source="$(realpath "$actual_source" 2>/dev/null || printf '%s' "$actual_source")"
        for protected_source in "${private_sources[@]}"; do
            if [[ "$source" == / || "$source" == "$protected_source" ||
                  "$source" == "$protected_source/"* || "$protected_source" == "$source/"* ]]; then
                echo "error: mount at $actual_target exposes host-only session or management data" >&2
                errors=$((errors + 1))
            fi
        done
        [[ "$actual_rw" == true ]] || continue
        for protected_source in "${control_sources[@]}"; do
            if [[ "$source" == / || "$source" == "$protected_source" ||
                  "$source" == "$protected_source/"* || "$protected_source" == "$source/"* ]]; then
                # Recognize only the two exact old protocol bindings. Extra
                # writable aliases never inherit that legacy exception.
                if [[ "$layout" == legacy && "$source" == "$protected_source" ]]; then
                    if [[ "$source" == "$host_bin_source" && "$actual_target" == /home/dev/bin ]] ||
                       [[ "$source" == "$host_git_source" && "$actual_target" == /home/dev/.gitconfig ]]; then
                        continue
                    fi
                fi
                echo "error: writable mount at $actual_target aliases protected host control files" >&2
                errors=$((errors + 1))
            fi
        done
    done <<<"$mounts"

    _c0_check_mount() {
        local host_path="$1" target="$2" kind="$3" display="$4" readonly="$5"
        local expected_type expected_source expected_rw=true found=false
        local actual_type actual_source actual_target actual_rw actual_name
        while [[ "$target" != / && "$target" == */ ]]; do target="${target%/}"; done
        if [[ "$layout" == legacy ]]; then
            case "$target" in
                /run/c0/host-bin) target=/home/dev/bin; readonly="" ;;
                /home/dev/.gitconfig) readonly="" ;;
            esac
        fi
        expected_targets+="$target"$'\n'
        if [[ "$kind" == docker-volume ]]; then
            expected_type=volume
            case "$target" in
                /tools/current) expected_source="$SHARED_TOOLS_VOLUME" ;;
                /run/c0/overlay-state) expected_source="$expected_overlay" ;;
                *) echo "error: unrecognized named volume at $target" >&2; errors=$((errors + 1)); return 0 ;;
            esac
        else
            expected_type=bind
            if { [[ "$kind" == host-dir ]] && [[ ! -d "$host_path" ]]; } ||
                { [[ "$kind" == host-file ]] && [[ ! -f "$host_path" ]]; }; then
                echo "error: host mount source missing or wrong type: $host_path ($kind)" >&2
                errors=$((errors + 1))
                return 0
            fi
            expected_source="$(realpath "$host_path")" || { errors=$((errors + 1)); return 0; }
        fi
        [[ "$readonly" != ro ]] || expected_rw=false
        while IFS=$'\t' read -r actual_type actual_source actual_target actual_rw actual_name; do
            [[ "$actual_target" == "$target" ]] || continue
            found=true
            if [[ "$actual_type" == bind ]]; then
                actual_source="$(realpath "$actual_source" 2>/dev/null || printf '%s' "$actual_source")"
            else
                actual_source="$actual_name"
            fi
            if [[ "$actual_type" != "$expected_type" || "$actual_source" != "$expected_source" || "$actual_rw" != "$expected_rw" ]]; then
                echo "error: mount mismatch at $target: expected $expected_type $expected_source (rw=$expected_rw), found $actual_type $actual_source (rw=$actual_rw)" >&2
                errors=$((errors + 1))
            fi
            break
        done <<<"$mounts"
        if [[ "$found" != true ]]; then
            echo "error: container $cid is missing mount $target ($expected_source)" >&2
            errors=$((errors + 1))
        fi
        if [[ "$kind" == host-file ]]; then
            guest_checks+=(f "$target")
        elif [[ "$target" != /run/c0/overlay-state ]]; then
            guest_checks+=(d "$target")
        fi
    }

    # These control bindings belong to the launcher protocol, not editable
    # desired volume mappings. Existing guests retain their creation contract.
    _c0_check_mount "$C0ROOT/bin" /run/c0/host-bin host-dir bin ro
    _c0_check_mount "$HOME/.gitconfig" /home/dev/.gitconfig host-file gitconfig ro
    _c0_check_mount "$C0ROOT/docker/docker-entrypoint.sh" /usr/local/bin/docker-entrypoint.sh host-file entrypoint ro
    _c0_check_mount "$C0ROOT/docker/home-overlays.conf" /etc/c0dev/home-overlays.conf host-file overlays ro
    _c0_check_mount "$C0ROOT/docker/c0-overlay-check" /usr/local/bin/c0-overlay-check host-file overlay-check ro
    _c0_check_mount "" /tools/current docker-volume tools ro
    _c0_check_mount "" /run/c0/overlay-state docker-volume overlays rw
    contract="$(docker inspect -f '{{ index .Config.Labels "c0dev.mount_contract" }}' "$cid")" || return 1
    case "$contract" in
        c0-mount-contract-v1$'\n'*)
            while IFS=$'\t' read -r host target kind display readonly; do
                [[ -n "$target" ]] || continue
                case "$kind" in host-dir|host-file|docker-volume) ;; *) return 1 ;; esac
                _c0_check_mount "$host" "$target" "$kind" "$display" "$readonly"
            done <<<"${contract#*$'\n'}"
            ;;
        ''|'<no value>')
            # Old guests have no saved desired roster. Their immutable Docker
            # data binds are authoritative; today's defaults cannot invent a
            # missing mount or revoke a previously selected custom source.
            ;;
        *) echo 'error: invalid recorded container mount contract' >&2; return 1 ;;
    esac
    while IFS=$'\t' read -r actual_type actual_source actual_target actual_rw actual_name; do
        [[ -n "$actual_target" ]] || continue
        [[ "$expected_targets" != *$'\n'"$actual_target"$'\n'* ]] || continue
        # This optional relay is generated separately from the volume files.
        if [[ "$actual_target" == "$relay" && "$actual_type" == bind && "$actual_source" == "$relay" ]]; then
            continue
        fi
        # Custom binds are immutable Docker creation metadata. Do not demand
        # mappings newly added to YAML, or re-point a retained bind from it.
        if [[ "$actual_type" == bind ]]; then
            case "$actual_target" in
                /|/home|/home/dev|/home/dev/bin|/home/dev/bin/*|/home/dev/.gitconfig/*|/home/dev/.ssh/*|/run|/run/*|/tools|/tools/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/etc|/etc/*|/usr|/usr/*|/bin|/bin/*|/var/run/*) ;;
                *)
                    kind=host-file
                    [[ ! -d "$actual_source" ]] || kind=host-dir
                    readonly=rw
                    [[ "$actual_rw" != false ]] || readonly=ro
                    _c0_check_mount "$actual_source" "$actual_target" "$kind" "$actual_source" "$readonly"
                    continue
                    ;;
            esac
        fi
        echo "error: unexpected container mount at $actual_target" >&2
        errors=$((errors + 1))
    done <<<"$mounts"
    subpath="$(docker inspect -f '{{range .HostConfig.Mounts}}{{if eq .Target "/tools/current"}}{{if .VolumeOptions}}{{.VolumeOptions.Subpath}}{{end}}{{end}}{{end}}' "$cid")" || return 1
    if [[ "$subpath" != "opt/$tools_id" ]]; then
        echo "error: tools mount subpath is '$subpath'; expected opt/$tools_id" >&2
        errors=$((errors + 1))
    fi
    if [[ "$errors" -gt 0 ]]; then
        echo "error: container mounts do not match this checkout; container and data were left unchanged" >&2
        return 1
    fi
    C0_CONTAINER_TOOLS_ID="$tools_id"
    C0_CONTAINER_LAYOUT="$layout"
    [[ "$check_guest" == true ]] || return 0
    guest_checks+=(f "$TOOLS_PREFIX/.c0dev-complete")
    # Check as the normal guest user: a correct-looking mount can still have a
    # deleted backend, wrong permissions, or a dangling link inside the home.
    if ! docker exec -u 1000 "$cid" sh -ec '
        layout=$1
        shift
        while [ "$#" -gt 0 ]; do
            kind=$1 path=$2
            shift 2
            if [ "$kind" = d ]; then
                [ -d "$path" ] && [ -r "$path" ] && [ -x "$path" ] || {
                    echo "error: guest directory is inaccessible: $path" >&2; exit 1;
                }
                (cd "$path" && ls -d . >/dev/null) || exit 1
            else
                [ -f "$path" ] && [ -r "$path" ] || {
                    echo "error: guest file is inaccessible: $path" >&2; exit 1;
                }
            fi
        done
        for path in /home/dev/* /home/dev/.[!.]* /home/dev/..?*; do
            if [ -L "$path" ] && [ ! -e "$path" ]; then
                echo "error: broken guest home link: $path" >&2; exit 1
            fi
        done
        if [ "$layout" = current ]; then
            [ "$(findmnt -T /home/dev/bin -n -o FSTYPE)" = overlay ] || {
                echo "error: guest bin overlay is missing; run c0 start to initialize mounts" >&2; exit 1
            }
            case ",$(findmnt -T /home/dev/bin -n -o OPTIONS)," in
                *,lowerdir=/run/c0/host-bin,*|*,lowerdir=/proc/1/root/run/c0/host-bin,*|*,lowerdir=1/root/run/c0/host-bin,*) ;;
                *) echo "error: guest bin overlay has unexpected lowerdir" >&2; exit 1 ;;
            esac
        fi
    ' c0-mount-check "$layout" "${guest_checks[@]}"; then
        echo "error: container $cid has inaccessible guest paths; check the reported paths and mount sources" >&2
        C0_CONTAINER_LAYOUT=""
        C0_CONTAINER_TOOLS_ID=""
        return 1
    fi
}

# Validate all host paths exist and are correct type
# Returns 0 if valid, 1 if errors; prints errors to stderr
validate_host_paths() {
    local errors=()
    local missing_dirs=()
    local missing_files=()

    _validate_folder_callback() {
    local abs_host_path="$1"
    local container_path="$2"
        local type="$3"
        local display_path="$4"

        if [[ "$type" == "host-dir" && -n "$abs_host_path" ]]; then
            if [[ ! -e "$abs_host_path" ]]; then
                errors+=("missing: $display_path")
                missing_dirs+=("$abs_host_path")
            elif [[ ! -d "$abs_host_path" ]]; then
                errors+=("not a directory (remove file first): $display_path")
            fi
        fi
    }

    _validate_file_callback() {
        local abs_host_path="$1"
        local container_path="$2"
        local type="$3"
        local display_path="$4"

        if [[ "$type" == "host-file" && -n "$abs_host_path" ]]; then
            if [[ ! -e "$abs_host_path" ]]; then
                errors+=("missing: $display_path")
                missing_files+=("$abs_host_path")
            elif [[ ! -f "$abs_host_path" ]]; then
                errors+=("not a file: $display_path")
            fi
        fi
    }

    parse_folder_mappings _validate_folder_callback
    parse_file_mappings _validate_file_callback

    # Non-destructive: ensure mutable tool cache dirs exist on host (never purge)
    if [[ -d "$C0ROOT/.cache" ]]; then
        mkdir -p "$C0ROOT/.cache/cargo" "$C0ROOT/.cache/uv" 2>/dev/null || true
    fi

    if [[ ${#errors[@]} -gt 0 ]]; then
        echo "error: host path validation failed:" >&2
        for err in "${errors[@]}"; do
            echo "  - $err" >&2
        done
        # Suggest fix for missing paths
        if [[ ${#missing_dirs[@]} -gt 0 || ${#missing_files[@]} -gt 0 ]]; then
            echo "" >&2
            echo "create missing paths:" >&2
            for d in "${missing_dirs[@]}"; do
                echo "  mkdir -p \"$d\"" >&2
            done
            for f in "${missing_files[@]}"; do
                echo "  touch \"$f\"" >&2
            done
        fi
        return 1
    fi
    return 0
}

# Check if a tools hash directory is complete on the shared volume
tools_volume_hash_complete() {
    local h="$1"
    [[ -z "$h" ]] && return 1
    if ! docker volume inspect "$SHARED_TOOLS_VOLUME" &>/dev/null; then
        return 1
    fi
    c0_docker_run -v "$SHARED_TOOLS_VOLUME:/tools:ro" alpine \
        test -f "/tools/opt/$h/.c0dev-complete" 2>/dev/null
}

# Build cache acceptance is stricter than legacy guest compatibility: a marker
# from an interrupted or foreign build cannot stand in for resolved releases.
tools_volume_build_matches() {
    local h="$1" location="${2:-opt/$1}" metadata="$C0_BUILD_CONTEXT/.cached-toolchain.json"
    c0_docker_run --user 1000:1000 --network none -v "$SHARED_TOOLS_VOLUME:/tools:ro" alpine \
        sh -c 'test -f "$1/.c0dev-complete" && cat "$1/.c0dev-toolchain.json"' sh \
        "/tools/$location" >"$metadata" 2>/dev/null || return 1
    cmp -s "$C0_BUILD_CONTEXT/c0-toolchain.json" "$metadata"
}

# Start has no release lookup or build context. Validate a staged build against
# its content identity before using it after the previous runtime is removed.
tools_volume_staged_matches() {
    (
        local hash="$1" metadata manifest_sha expected
        [[ "$hash" =~ ^[0-9a-f]{64}$ && "${TOOLS_RECIPE_ID:-}" =~ ^[0-9a-f]{64}$ ]] || exit 1
        metadata="$(mktemp "${TMPDIR:-/tmp}/c0-staged-toolchain.XXXXXX")" || exit 1
        trap 'rm -f "$metadata"' EXIT
        c0_docker_run --user 1000:1000 --network none -v "$SHARED_TOOLS_VOLUME:/tools:ro" alpine \
            sh -c 'test -f "$1/.c0dev-complete" && cat "$1/.c0dev-toolchain.json"' sh \
            "/tools/tmp/$hash.next" >"$metadata" 2>/dev/null || exit 1
        "$C0ROOT/bin/c0-toolchain" --build-args "$metadata" >/dev/null 2>&1 || exit 1
        manifest_sha="$(shasum -a 256 "$metadata" | awk '{print $1}')" || exit 1
        expected="$(printf 'c0-toolchain-build-v1\n%s\n%s\n' \
            "$TOOLS_RECIPE_ID" "$manifest_sha" | shasum -a 256 | awk '{print $1}')" || exit 1
        [[ "$hash" == "$expected" ]]
    )
}

# Check if shared tools volume has complete tools for current TOOLS_ID
tools_volume_valid() {
    tools_volume_hash_complete "$TOOLS_ID"
}

tools_volume_invalid_hint() {
    if ! docker volume inspect "$SHARED_TOOLS_VOLUME" &>/dev/null; then
        echo "hint: volume ${SHARED_TOOLS_VOLUME} missing — run 'c0 build'" >&2
        return 0
    fi
    echo "hint: no tools at /tools/opt/${TOOLS_ID} — run 'c0 build'" >&2
    if [[ "$TOOLS_ID" == "$TOOLS_BUILD_ID" ]]; then
        echo "hint: build tools id hashes Dockerfile.base + Dockerfile.tools (runtime Dockerfile excluded)" >&2
    else
        echo "hint: this checkout selected an accepted tools snapshot that is no longer complete" >&2
    fi
}

# Get project relative path for shell navigation
get_project_path() {
    local current_dir="$(realpath "$(pwd)")"
    local projects_dir="$C0ROOT/projects"

    if [[ "$current_dir" == "$projects_dir" ]]; then
        echo "."
    elif [[ "$current_dir" == "$projects_dir"* ]]; then
        echo "${current_dir#$projects_dir/}"
    else
        echo ""
    fi
}

# Host-only guard
require_host() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        echo "error: '$1' must be run from host, not inside container" >&2
        exit 1
    fi
}

# =============================================================================
# Tools volume and runtime identity helpers (Phase 1)
# =============================================================================

# Check if tools volume exists
tools_volume_exists() {
    docker volume inspect "$SHARED_TOOLS_VOLUME" &>/dev/null
}

# Execute shell command in tools volume using alpine container
tools_volume_sh() {
    c0_docker_run --network none -v "$SHARED_TOOLS_VOLUME:/tools" alpine sh -c "$*"
}

# Rotation/GC of dev-owned snapshots: root needs DAC_OVERRIDE+FOWNER under cap_drop ALL.
tools_volume_admin_sh() {
    c0_docker_run --network none --cap-add DAC_OVERRIDE --cap-add FOWNER \
        -v "$SHARED_TOOLS_VOLUME:/tools" alpine sh -c "$*"
}

# Stopped containers are resumable and still retain their selected snapshot.
list_container_ids_using_tools_volume() {
    docker ps -aq --filter "volume=$SHARED_TOOLS_VOLUME"
}

# Get tools hash label from a container
get_tools_hash_label() {
    local container_id="$1"
    docker inspect "$container_id" --format '{{ index .Config.Labels "c0dev.tools_hash" }}'
}

# Get unique protected hashes from running and stopped containers
get_active_hashes() {
    local -a hashes=()
    local container_id hash ids
    ids="$(list_container_ids_using_tools_volume)" || return 1

    while IFS= read -r container_id; do
        [[ -z "$container_id" ]] && continue
        hash="$(get_tools_hash_label "$container_id")" || return 1
        [[ -n "$hash" ]] && hashes+=("$hash")
    done <<<"$ids"

    # Return unique hashes (sorted)
    if [[ ${#hashes[@]} -gt 0 ]]; then
        printf '%s\n' "${hashes[@]}" | sort -u
    fi
}

# =============================================================================
# Tools selection and collection derive from Docker artifacts, never registries.
# =============================================================================

set_tools_id() {
    local tools_id="$1"
    if [[ ! "$tools_id" =~ ^[0-9a-f]{64}$ ]]; then
        echo "error: invalid tools id: $tools_id" >&2
        return 1
    fi
    TOOLS_ID="$tools_id"
    TOOLS_PREFIX="/tools/current"
    export TOOLS_ID TOOLS_PREFIX
}

resolve_tools_selection() {
    c0_resolve_shared_build || return 1
    set_tools_id "$TOOLS_BUILD_ID"
}

# Every published runtime image names its immutable tools content. Multiple
# workspaces and stopped containers may legitimately retain older content.
get_published_tools_hashes() {
    local images image hash
    local -a hashes=()
    images="$(docker image ls -aq --filter "label=c0dev.tools_volume=$SHARED_TOOLS_VOLUME")" || return 1
    while IFS= read -r image; do
        [[ -n "$image" ]] || continue
        hash="$(docker image inspect --format '{{ index .Config.Labels "c0dev.tools_hash" }}' "$image")" || return 1
        [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || {
            echo "error: published Docker artifact has an invalid tools reference: $image" >&2
            return 1
        }
        hashes+=("$hash")
    done <<<"$images"
    if [[ ${#hashes[@]} -gt 0 ]]; then printf '%s\n' "${hashes[@]}" | sort -u; fi
}

# Only a reproducible cache for this recipe is eligible for collection. Legacy
# snapshots and accepted native changes are retained when ownership is unknown.
tools_volume_cache_matches() {
    (
        local hash="$1" metadata manifest_sha expected
        [[ "$hash" =~ ^[0-9a-f]{64}$ && "${TOOLS_RECIPE_ID:-}" =~ ^[0-9a-f]{64}$ ]] || exit 1
        metadata="$(mktemp "${TMPDIR:-/tmp}/c0-cache-toolchain.XXXXXX")" || exit 1
        trap 'rm -f "$metadata"' EXIT
        c0_docker_run --user 1000:1000 --network none -v "$SHARED_TOOLS_VOLUME:/tools:ro" alpine \
            sh -c 'test -f "$1/.c0dev-complete" && test ! -e "$1/.c0dev-parent" && test ! -e "$1/.c0dev-stage-sha256" && cat "$1/.c0dev-toolchain.json"' sh \
            "/tools/opt/$hash" >"$metadata" 2>/dev/null || exit 1
        "$C0ROOT/bin/c0-toolchain" --build-args "$metadata" >/dev/null 2>&1 || exit 1
        manifest_sha="$(shasum -a 256 "$metadata" | awk '{print $1}')" || exit 1
        expected="$(printf 'c0-toolchain-build-v1\n%s\n%s\n' \
            "$TOOLS_RECIPE_ID" "$manifest_sha" | shasum -a 256 | awk '{print $1}')" || exit 1
        [[ "$hash" == "$expected" ]]
    )
}

gc_tools_hashes() {
    [[ "$IN_CONTAINER" != true ]] || return 0
    tools_volume_exists || return 0
    local active published protected hash hash_dirs
    active="$(get_active_hashes)" || return 1
    published="$(get_published_tools_hashes)" || return 1
    protected="$(printf '%s\n%s\n' "$active" "$published" | sort -u)"
    hash_dirs="$(tools_volume_sh "ls -1 /tools/opt 2>/dev/null || true")" || return 1
    while IFS= read -r hash; do
        [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || continue
        if printf '%s\n' "$protected" | grep -qx "$hash"; then continue; fi
        tools_volume_cache_matches "$hash" || continue
        tools_volume_admin_sh "rm -rf '/tools/opt/$hash'" || return 1
        echo -e "  🗑️  GC: ${YELLOW}${hash:0:12}...${NC}"
    done <<<"$hash_dirs"
}

# =============================================================================
# Build: tools volume (transactional) with staged rebuild support (Phase 4)
# =============================================================================

# Promote staged .next build to final location (if safe)
maybe_promote_staged_next() {
    local hash="$1"
    local VOL="$SHARED_TOOLS_VOLUME"

    [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1

    if ! tools_volume_exists; then
        return 0
    fi

    # Check if .next staging exists
    if ! tools_volume_sh "test -d '/tools/tmp/$hash.next'" 2>/dev/null; then
        return 0
    fi
    # Check if hash is still active
    local active_hashes
    active_hashes="$(get_active_hashes)" || return 1
    if echo "$active_hashes" | grep -qx "$hash"; then
        # Still referenced, cannot replace files used by a retained container.
        if [[ -z "${C0_BUILD_CONTEXT:-}" ]]; then
            echo 'warning: rebuilt tools remain staged because retained containers still use this snapshot; using existing tools' >&2
        fi
        return 0
    fi

    if [[ -n "${C0_BUILD_CONTEXT:-}" ]]; then
        if ! tools_volume_build_matches "$hash" "tmp/$hash.next"; then
            echo 'warning: ignoring incomplete or mismatched staged tools build' >&2
            return 0
        fi
    elif ! tools_volume_staged_matches "$hash"; then
        echo 'warning: ignoring incomplete or mismatched staged tools build; existing tools retained' >&2
        return 0
    fi

    # Safe to promote
    echo -e "  📥 Promoting staged build..."
    if tools_volume_admin_sh "
        set -e
        mkdir -p /tools/opt
        rm -rf '/tools/opt/$hash.old'
        if [ -d '/tools/opt/$hash' ]; then
            mv '/tools/opt/$hash' '/tools/opt/$hash.old'
        fi
        mv '/tools/tmp/$hash.next' '/tools/opt/$hash'
        rm -rf '/tools/opt/$hash.old'
    " 2>/dev/null; then
        echo -e "  ✅ Promoted: ${GREEN}/tools/opt/${hash:0:12}...${NC}"
    else
        echo "warning: failed to promote staged build" >&2
        return 1
    fi
}

# The constructed image is a filesystem input, never a store writer.
c0_publish_tools_payload() {
    local identity="$1" payload="$2"
    [[ "$identity" =~ ^[0-9a-f]{64}$ && -n "${C0_BASE_IMAGE:-}" ]] || return 1
    c0_docker_run --pull=never --network none --read-only --user 0:0 \
        --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
        -i -v "$SHARED_TOOLS_VOLUME:/tools" -v "$payload:/payload:ro" \
        --entrypoint /bin/sh "$C0_BASE_IMAGE" -eu -s -- "$identity" \
        <"$C0ROOT/docker/c0-publish-tools"
}

c0_extract_built_tools() {
    (
        local image="$1" identity="$2" source_id="" copied operation status owner state
        [[ "$identity" =~ ^[0-9a-f]{64}$ && -d "$C0_BUILD_CONTEXT" ]] || exit 1
        copied="$(mktemp -d "$C0_BUILD_CONTEXT/.tools-payload.XXXXXX")" || exit 1
        operation="$(basename "$copied")"
        c0_finish_extraction() {
            status=$?
            trap - EXIT INT TERM HUP
            if [[ -n "$source_id" ]]; then
                owner="$(docker inspect --format '{{index .Config.Labels "c0dev.extraction_operation"}}' "$source_id")" || owner=""
                state="$(docker inspect --format '{{.State.Status}}' "$source_id")" || state=""
                if [[ "$owner" == "$operation" && "$state" == created ]]; then
                    docker rm "$source_id" >/dev/null || status=1
                else
                    echo "error: retaining extraction container $source_id: ownership or stopped state is uncertain" >&2
                    status=1
                fi
            fi
            rm -rf -- "$copied"
            exit "$status"
        }
        trap c0_finish_extraction EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM HUP
        source_id="$(docker create --pull=never --network none --cap-drop ALL \
            --security-opt no-new-privileges:true \
            --label "c0dev.extraction_operation=$operation" \
            --entrypoint /bin/false "$image")" || exit 1
        if [[ ! "$source_id" =~ ^[0-9a-f]{64}$ ]]; then
            echo 'error: invalid extraction container identity; no named cleanup attempted' >&2
            source_id=""
            exit 1
        fi
        state="$(docker inspect --format '{{.State.Status}}' "$source_id")" || exit 1
        [[ "$state" == created ]] || { echo 'error: extraction source was unexpectedly started' >&2; exit 1; }
        docker cp "$source_id:/home/dev/." "$copied" || exit 1
        c0_publish_tools_payload "$identity" "$copied"
    )
}

build_tools_volume() {
    local force="${1:-false}"
    local nocache="${2:-}"
    local H="$TOOLS_BUILD_ID"
    local VOL="$SHARED_TOOLS_VOLUME"
    local TAG="c0dev-tools-builder-${C0_MODE_KEY}:$H"

    if ! verify_moby_seccomp_profile; then
        return 1
    fi

    # Try to promote any staged .next build for this hash (Phase 4)
    maybe_promote_staged_next "$H" || return 1

    # Check if rebuild needed
    if [[ "$force" != "true" ]] && tools_volume_build_matches "$H"; then
        echo -e "📦 Tools: ${GREEN}valid${NC}"
        return 0
    fi

    echo -e "📦 Tools: building..."

    # Existing containers are never ours to delete merely by a legacy name.

    # 1) Ensure volume exists
    docker volume create "$VOL" >/dev/null

    # 2) Build tools image (BuildKit builder is short-lived; service hardening is in compose at runtime)
    echo -e "  🔧 Building tools-builder stage..."
    export DOCKER_BUILDKIT=1
    c0_prepare_tools_dockerfile
    if ! docker build --pull $nocache "${C0_TOOLCHAIN_BUILD_ARGS[@]}" \
        --label "c0dev.mode=$C0_MODE_KEY" --label "c0dev.tools_hash=$H" \
        -f "$DOCKERFILE_TOOLS_BUILD" --target tools-builder -t "$TAG" "$C0_BUILD_CONTEXT"; then
        return 1
    fi

    # 3) Pack immutable paths and extract to tools volume as dev (image USER; no chown under cap_drop)
    echo -e "  📤 Extracting to temp..."
    if ! tools_volume_admin_sh "
            set -e
            rm -rf '/tools/tmp/$H.partial'
            mkdir -p '/tools/tmp' '/tools/tmp/$H.partial'
            chmod 1777 '/tools/tmp'
            chmod 777 '/tools/tmp/$H.partial'
        "; then
        return 1
    fi
    if ! c0_extract_built_tools "$TAG" "$H"; then
        tools_volume_admin_sh "rm -rf '/tools/tmp/$H.partial'" 2>/dev/null || true
        return 1
    fi

    # 5) Check if hash is active - if so, stage instead of promoting (Phase 4)
    local active_hashes
    active_hashes="$(get_active_hashes)" || return 1
    local is_active=false
    if echo "$active_hashes" | grep -qx "$H"; then
        is_active=true
    fi

    local verified_location="opt/$H"
    if [[ "$is_active" == "true" ]]; then
        # Stage to .next instead of promoting
        echo -e "  📦 Staging (hash is active)..."
        if ! tools_volume_admin_sh "
            set -e
            mkdir -p /tools/tmp
            rm -rf '/tools/tmp/$H.next.old'
            if [ -d '/tools/tmp/$H.next' ]; then
                mv '/tools/tmp/$H.next' '/tools/tmp/$H.next.old'
            fi
            mv '/tools/tmp/$H.partial' '/tools/tmp/$H.next'
            rm -rf '/tools/tmp/$H.next.old'
        "; then
            return 1
        fi
        echo -e "  ⏸️  Staged: will promote after instances stop"
        verified_location="tmp/$H.next"
    else
        # Safe to promote directly
        echo -e "  📥 Promoting..."
        if ! tools_volume_admin_sh "
            set -e
            mkdir -p /tools/opt
            rm -rf '/tools/opt/$H.old'
            if [ -d '/tools/opt/$H' ]; then
                mv '/tools/opt/$H' '/tools/opt/$H.old'
            fi
            mv '/tools/tmp/$H.partial' '/tools/opt/$H'
            rm -rf '/tools/opt/$H.old'
            rm -rf '/tools/tmp/$H.partial'
        "; then
            return 1
        fi
    fi

    # 6) Post-verify
    if ! tools_volume_build_matches "$H" "$verified_location"; then
        echo "error: tools build failed - snapshot metadata does not match resolved toolchain" >&2
        return 1
    fi
    if [[ "$verified_location" != "opt/$H" ]] && ! tools_volume_build_matches "$H"; then
        echo "error: retained guest references an incomplete tools snapshot; replacement is staged, existing guest data was preserved" >&2
        return 1
    fi

    # Cleanup builder image
    docker rmi "$TAG" >/dev/null 2>&1 || true

    echo -e "  ✅ Tools: ${GREEN}complete${NC}"
}

# =============================================================================
# Commands
# =============================================================================

c0_create_runtime() {
    local name="$1" selection contract
    local C0_HOME_OVERLAYS_VOLUME C0_HOME_OVERLAYS_EXTERNAL
    selection="$(c0_discover_home_storage)" || return 1
    IFS=$'\t' read -r C0_HOME_OVERLAYS_VOLUME C0_HOME_OVERLAYS_EXTERNAL <<<"$selection"
    # These are computed Compose inputs, never caller-supplied options.
    # One-off creation leaves any retained containers with Compose labels intact.
    _c0_record_creation_mount() {
        local host="$1" target="$2" kind="$3" display="$4" readonly="${5:-rw}"
        # Empty columns cannot round-trip through Bash's whitespace IFS.
        [[ -n "$host" ]] || host=-
        [[ -n "$display" ]] || display=-
        case "$host$target$display" in *$'\n'*|*$'\t'*) return 1 ;; esac
        printf '%s\t%s\t%s\t%s\t%s\n' "$host" "$target" "$kind" "$display" "$readonly"
    }
    contract="$(printf 'c0-mount-contract-v1\n'; parse_folder_mappings _c0_record_creation_mount && parse_file_mappings _c0_record_creation_mount)" || return 1
    unset -f _c0_record_creation_mount
    dc run --no-deps -d --pull never --service-ports --name "$name" \
        --label "c0dev.mount_contract=$contract" "$MAIN_SERVICE" >/dev/null
}

cmd_start() {
    require_host "start"
    c0_require_docker || return 1
    c0_resolve_runtime_context || return 1
    local cid state name arg
    cid="$(get_c0_container_id_any)" || return 1
    if [[ -n "$cid" ]]; then
        for arg in "$@"; do
            [[ "$arg" == --least-privilege ]] || { echo "error: unknown option: $arg" >&2; return 1; }
        done
        c0_validate_container_mounts "$cid" false true || return 1
        c0_ssh_ensure_keys || return 1
        set_tools_id "$C0_CONTAINER_TOOLS_ID" || return 1
        state="$(get_c0_container_state "$cid")" || return 1
        name="$(docker inspect -f '{{.Name}}' "$cid")" || return 1
        name="${name#/}"
        if [[ "$state" != running ]]; then
            case "$state" in
                exited|created) docker start "$cid" >/dev/null || return 1 ;;
                paused) docker unpause "$cid" >/dev/null || return 1 ;;
                *) echo "error: cannot start container $cid in state $state; container was left unchanged" >&2; return 1 ;;
            esac
        fi
        if ! c0_start_ready "$cid" true; then
            if [[ "$state" != running ]]; then docker stop "$cid" >/dev/null || true; fi
            return 1
        fi
        if [[ "$state" == running ]]; then
            echo -e "✅ Already running: ${GREEN}${name}${NC} (${CYAN}$C0_INSTANCE_ID${NC})"
        else
            echo -e "✅ Started: ${GREEN}${name}${NC} (existing container, not recreated)"
        fi
        [[ $# -eq 0 ]] || echo "note: existing container retains its creation-time security settings" >&2
        print_security_mode "$cid"
        print_ssh_auth_mapping
        print_ssh_server_mapping
        print_orca_endpoint
        print_web_port_mapping
        return 0
    fi

    # Writable home overlays belong to the workspace. Two different builds
    # must not mount the same upper/work directories concurrently.
    local workspace_running
    workspace_running="$(c0_list_workspace_containers -q)" || return 1
    if [[ -n "$workspace_running" ]]; then
        echo "error: another build is running in this workspace; use c0 stop before starting the current build" >&2
        return 1
    fi

    resolve_c0_security_for_start "$@" || return 1
    resolve_tools_selection || return 1
    ensure_web_port || return 1
    ensure_ssh_port || return 1
    c0_ssh_ensure_keys || return 1
    c0_ssh_write_sshd_config || return 1
    verify_moby_seccomp_profile || return 1
    maybe_notify_seccomp_update_available || true
    validate_host_paths || return 1
    maybe_promote_staged_next "$TOOLS_ID" || return 1
    if ! tools_volume_valid; then
        echo "error: tools volume invalid or missing - run 'c0 build' first" >&2
        tools_volume_invalid_hint
        return 1
    fi
    echo -e "🚀 Creating ${CYAN}$C0_INSTANCE_ID${NC}..."
    c0_create_runtime "${C0_INSTANCE_ID}-${MAIN_SERVICE}-1" || return 1
    cid="$(get_c0_container_id_any)" || return 1
    if [[ -z "$cid" ]]; then echo "error: creation returned without an instance container" >&2; return 1; fi
    if ! c0_start_ready "$cid"; then
        docker stop "$cid" >/dev/null || true
        return 1
    fi
    print_security_mode "$cid"
    print_ssh_auth_mapping
    print_ssh_server_mapping
    print_orca_endpoint
    print_web_port_mapping
    echo -e "✅ Started: ${GREEN}$MAIN_SERVICE${NC}"
}

cmd_stop() {
    require_host "stop"
    echo -e "🛑 Stopping ${CYAN}$C0_INSTANCE_ID${NC}..."
    c0_stop_instance || return 1
    echo -e "✅ Stopped"
}

cmd_restart() {
    cmd_stop || return $?
    cmd_start "$@"
}

cmd_logs() {
    require_host "logs"
    local service="${1:-$MAIN_SERVICE}" cid
    [[ "$service" == "$MAIN_SERVICE" ]] || { echo "error: unknown service: $service" >&2; return 1; }
    c0_require_docker || return 1
    c0_resolve_runtime_context || return 1
    cid="$(get_c0_container_id_any)" || return 1
    [[ -n "$cid" ]] || { echo "error: no container for $C0_INSTANCE_ID" >&2; return 1; }
    docker logs -f "$cid"
}

cmd_status() {
    require_host "status"
    c0_require_docker || exit 1
    # Status must not execute guest code or depend on any container image.
    # Pins and completeness markers are volume contents, not Docker metadata.
    # Report Docker-owned runtime identity without depending on an image tag.
    local launcher_tools_id="$TOOLS_ID"
    local TOOLS_ID="" status_cid
    status_cid="$(get_c0_container_id_any)"
    if [[ -z "$status_cid" ]]; then
        local workspace_ids
        workspace_ids="$(c0_list_workspace_containers -aq)" || return 1
        if [[ -n "$workspace_ids" && "$workspace_ids" != *$'\n'* ]]; then
            status_cid="$workspace_ids"
        fi
    fi
    if [[ -n "$status_cid" ]]; then
        TOOLS_ID="$(get_tools_hash_label "$status_cid")"
        [[ "$TOOLS_ID" =~ ^[0-9a-f]{64}$ ]] || TOOLS_ID=""
    fi

    echo -e "${BOLD}instance:${NC} ${CYAN}$C0_INSTANCE_ID${NC}"
    echo -e "${BOLD}c0:${NC} ${YELLOW}$C0_BIN${NC}"
    echo -e "${BOLD}root:${NC} ${YELLOW}$C0ROOT${NC}"
    echo -e "${BOLD}mode:${NC} $C0_MODE_KEY"
    echo ""

    # Port mapping (if container exists)
    echo -e "${BOLD}ports:${NC}"
    local mapped_port mapped_ssh_port orca_endpoint
    mapped_port="$(get_current_web_port || true)"
    mapped_ssh_port="$(get_current_ssh_port || true)"
    orca_endpoint="$(orca_remote_display)"
    if [[ -n "$mapped_port" ]]; then
        echo -e "  🌐 ${YELLOW}host:${mapped_port}${NC} -> ${YELLOW}guest:3000${NC}"
    else
        echo -e "  🌐 ${YELLOW}(none)${NC}"
    fi
    if [[ -n "$mapped_ssh_port" ]]; then
        echo -e "  🔐 ${YELLOW}127.0.0.1:${mapped_ssh_port}${NC} -> ${YELLOW}$(ssh_remote_display)${NC}"
    else
        echo -e "  🔐 ${YELLOW}(none)${NC}"
    fi
    if [[ -n "$orca_endpoint" ]]; then
        echo -e "  🐋 ${YELLOW}${orca_endpoint}${NC}"
    fi
    echo ""

    echo -e "${BOLD}security:${NC}"
    local running_security configured_security container_cid container_state
    container_cid="$(get_c0_container_id_any)"
    container_state="$(get_c0_container_state "$container_cid")"
    running_security="$(get_c0_container_security_mode "$container_cid")"
    if [[ -n "$running_security" && "$container_state" == "running" ]]; then
        echo -e "  🔒 ${YELLOW}${running_security}${NC} (running)"
        if [[ -n "${C0_SECURITY:-}" && "${C0_SECURITY}" != "$running_security" ]]; then
            echo -e "  ${YELLOW}note:${NC} shell C0_SECURITY=${C0_SECURITY} differs; existing creation-time settings are retained"
        fi
    elif [[ -n "$running_security" && -n "$container_state" ]]; then
        echo -e "  🔒 ${YELLOW}${running_security}${NC} (${RED}${container_state}${NC})"
    else
        ensure_c0_security_resolved || true
        configured_security="${C0_SECURITY:-guest-admin}"
        echo -e "  🔒 ${YELLOW}${configured_security}${NC} (next start; default guest-admin)"
    fi
    echo ""

    echo -e "${BOLD}ssh agent:${NC}"
    if c0_ssh_agent_enabled; then
        echo -e "  ${YELLOW}${C0_SSH_AUTH_SOCK_PATH}${NC} (OrbStack relay; same-path socket bind)"
    elif [[ "${C0_SSH_AGENT:-1}" == "0" ]]; then
        echo -e "  ${YELLOW}(off — C0_SSH_AGENT=0)${NC}"
    else
        echo -e "  ${YELLOW}(off — set SSH_AUTH_SOCK on host; C0_SSH_AGENT=0 disables)${NC}"
    fi
    echo ""

    # This instance only (label c0dev.instance=$C0_INSTANCE_ID)
    echo -e "${BOLD}this instance:${NC}"
    local container_info container_name
    container_cid="$(get_c0_container_id)"
    if [[ -n "$container_cid" ]]; then
        container_name="$(docker inspect -f '{{.Name}}' "$container_cid" 2>/dev/null | sed 's|^/||')"
        container_info="${container_name}: running"
        echo -e "  ${GREEN}$container_info${NC}"
    else
        container_cid="$(get_c0_container_id_any)"
        if [[ -n "$container_cid" ]]; then
            container_name="$(docker inspect -f '{{.Name}}' "$container_cid" 2>/dev/null | sed 's|^/||')"
            container_state="$(get_c0_container_state "$container_cid")"
            container_info="${container_name}: ${container_state}"
            if [[ "$container_state" == "exited" ]]; then
                echo -e "  ${RED}$container_info${NC}"
                echo -e "  ${YELLOW}hint:${NC} docker logs ${container_name}" >&2
            else
                echo -e "  ${YELLOW}$container_info${NC}"
            fi
        else
            echo -e "  ${YELLOW}(none for this realpath instance)${NC}"
        fi
    fi
    echo ""

    # Volume mappings
    echo -e "${BOLD}volumes:${NC}"
    _status_mapping() {
        local abs_host_path="$1"
        local container_path="$2"
        local type="$3"
        local display_path="$4"
        local ro="$5"

        local ro_flag=""
        [[ "$ro" == "ro" ]] && ro_flag=" ${MAGENTA}[ro]${NC}"

        local status="ok"
        if [[ "$type" == "host-dir" && -n "$abs_host_path" ]]; then
            if [[ ! -e "$abs_host_path" ]]; then
                status="MISSING"
            elif [[ ! -d "$abs_host_path" ]]; then
                status="NOT-DIR"
            fi
        elif [[ "$type" == "host-file" && -n "$abs_host_path" ]]; then
            if [[ ! -e "$abs_host_path" ]]; then
                status="MISSING"
            elif [[ ! -f "$abs_host_path" ]]; then
                status="NOT-FILE"
            fi
        fi

        local type_color="$BLUE"
        [[ "$type" == "docker-volume" ]] && type_color="$MAGENTA"

        if [[ "$status" == "ok" ]]; then
            echo -e "  ${GREEN}✓${NC} ${type_color}[$type]${NC} ${CYAN}$display_path${NC} -> ${YELLOW}$container_path${NC}$ro_flag"
        else
            echo -e "  ${RED}✗${NC} ${type_color}[$type]${NC} ${CYAN}$display_path${NC} -> ${YELLOW}$container_path${NC} ${RED}($status)${NC}"
        fi
    }

    parse_folder_mappings _status_mapping
    parse_file_mappings _status_mapping
    echo ""

    echo -e "${BOLD}home overlays:${NC}"
    echo -e "  ${YELLOW}c0 tools${NC}"
    echo ""

    echo -e "${BOLD}tools:${NC}"
    echo -e "  recipe id: ${YELLOW}${TOOLS_RECIPE_ID:0:12}...${NC}"
    if [[ -n "$TOOLS_ID" ]]; then
        echo -e "  container tools id: ${YELLOW}${TOOLS_ID:0:12}...${NC}"
    else
        echo -e "  container tools id: ${YELLOW}(unknown)${NC}"
    fi
    if tools_volume_exists; then
        echo -e "  volume: ${GREEN}present${NC} (${CYAN}$SHARED_TOOLS_VOLUME${NC})"
    else
        echo -e "  volume: ${YELLOW}missing${NC} (${CYAN}$SHARED_TOOLS_VOLUME${NC})"
    fi
    echo -e "  snapshot completeness: ${YELLOW}(not checked)${NC}"
    echo ""

    echo -e "${BOLD}command environment (launcher inputs):${NC}"
    ( TOOLS_ID="$launcher_tools_id"; c0_command_environment show )
    echo ""

    # Docker labels describe the runtime/build ownership of existing workspaces.
    echo -e "${BOLD}workspace containers:${NC}"
    local workspace_containers workspace
    workspace_containers="$(docker ps -a \
        --filter "label=c0dev.tools_volume=$SHARED_TOOLS_VOLUME" \
        --filter label=c0dev.instance \
        --format '{{.Names}} ({{.Label "c0dev.instance"}}, {{.State}}; tools={{.Label "c0dev.tools_hash"}})')" || return 1
    if [[ -n "$workspace_containers" ]]; then
        while IFS= read -r workspace; do
            printf '  %s\n' "$workspace"
        done <<<"$workspace_containers"
    else
        echo -e "  ${YELLOW}(none)${NC}"
    fi
}

cmd_tools_stage_output() {
    local detail="${1:-false}"
    local cid changes counts added modified deleted opaque total

    c0_require_container_running || exit 1
    cid="$(get_c0_container_id)"
    changes="$(c0_home_overlay_porcelain "$cid")" || return 1

    if [[ -z "$changes" ]]; then
        echo -e "${BOLD}tools:${NC} ${GREEN}clean${NC}"
        return 0
    fi

    counts="$(printf '%s\n' "$changes" | awk -F '\t' '
        $1 == "A" { a++ }
        $1 == "M" { m++ }
        $1 == "D" { d++ }
        $1 == "O" { o++ }
        END { printf "%d %d %d %d", a+0, m+0, d+0, o+0 }
    ')"
    read -r added modified deleted opaque <<<"$counts"
    total=$((added + modified + deleted + opaque))

    echo -e "${BOLD}tools:${NC} ${YELLOW}staged${NC} (${total} paths)"
    echo "  added=$added modified=$modified deleted=$deleted opaque=$opaque"

    if [[ "$detail" == true ]]; then
        printf '%s\n' "$changes" | awk -F '\t' '{ printf "  %s  %s\n", $1, $2 }'
    else
        printf '%s\n' "$changes" | awk -F '\t' '$1 != "A" { printf "  %s  %s\n", $1, $2 }'
        if [[ "$added" -gt 0 ]]; then
            echo "  A  $added added paths (c0 tools --detail)"
        fi
    fi

    echo ""
    echo "  accept:  c0 tools accept"
    echo "  restore: c0 tools restore"
}

# Native tools acceptance produces an ordinary shared runtime artifact. Its
# immutable labels, rather than a workspace selector, publish the new payload.
c0_accept_runtime_metadata() {
    local cid="$1" image metadata build mode recipe tools volume base
    image="$(docker inspect --format '{{.Image}}' "$cid")" || return 1
    [[ "$image" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    metadata="$(docker image inspect --format '{{printf "%s\t%s\t%s\t%s\t%s\t%s\t%s" .Id (index .Config.Labels "c0dev.build") (index .Config.Labels "c0dev.mode") (index .Config.Labels "c0dev.recipe") (index .Config.Labels "c0dev.tools_hash") (index .Config.Labels "c0dev.tools_volume") (index .Config.Labels "c0dev.base_image")}}' "$image")" || return 1
    IFS=$'\t' read -r image build mode recipe tools volume base <<<"$metadata"
    if [[ ! "$build" =~ ^[0-9a-f]{64}$ || "$mode" != "$C0_MODE_KEY" ||
          "$recipe" != "$C0_RECIPE_ID" || "$tools" != "$TOOLS_ID" ||
          "$volume" != "$SHARED_TOOLS_VOLUME" || ! "$base" =~ ^c0dev-base-${C0_MODE_KEY}:[0-9a-f]{64}$ ]]; then
        echo 'error: tools acceptance requires a runtime from the shared build for this mode and recipe; guest data was not changed' >&2
        return 1
    fi
    printf '%s\n' "$metadata"
}

c0_publish_accepted_runtime() {
    (
        local metadata="$1" accepted="$2" image parent mode recipe tools volume base build source image_id
        local C0_BUILD_ID C0_BASE_IMAGE C0_RUNTIME_IMAGE C0_TOOLS_BUILDER_IMAGE C0_INSTANCE_ID
        local TOOLS_ID="$accepted" TOOLS_BUILD_ID="$accepted"
        local C0_BUILD_CONTEXT C0_RUNTIME_BUILD_TAG
        [[ "$accepted" =~ ^[0-9a-f]{64}$ ]] || exit 1
        IFS=$'\t' read -r image parent mode recipe tools volume base <<<"$metadata"
        [[ "$image" =~ ^sha256:[0-9a-f]{64}$ && "$parent" =~ ^[0-9a-f]{64}$ &&
           "$mode" == "$C0_MODE_KEY" && "$recipe" == "$C0_RECIPE_ID" &&
           "$volume" == "$SHARED_TOOLS_VOLUME" && "$base" =~ ^c0dev-base-${C0_MODE_KEY}:[0-9a-f]{64}$ ]] || exit 1
        docker image inspect "$base" >/dev/null || exit 1
        build="$(printf 'c0-tools-accept-build-v1\n%s\n%s\n' "$parent" "$accepted" | shasum -a 256 | awk '{print $1}')" || exit 1
        c0_set_build_identity "$build" || exit 1
        C0_BASE_IMAGE="$base"
        C0_BUILD_CONTEXT="$(mktemp -d "${TMPDIR:-/tmp}/c0-tools-image.XXXXXX")" || exit 1
        C0_RUNTIME_BUILD_TAG="c0dev-runtime-${C0_MODE_KEY}-build:$(basename "$C0_BUILD_CONTEXT")"
        source="$C0_RUNTIME_BUILD_TAG-source"
        trap 'docker image rm "$C0_RUNTIME_BUILD_TAG" "$source" >/dev/null 2>&1 || true; rm -rf "$C0_BUILD_CONTEXT"' EXIT
        docker image tag "$image" "$source" || exit 1
        printf 'FROM %s\n' "$source" >"$C0_BUILD_CONTEXT/Dockerfile" || exit 1
        docker build --pull=false --network none \
            --label "c0dev.mode=$C0_MODE_KEY" --label "c0dev.recipe=$C0_RECIPE_ID" \
            --label "c0dev.build=$build" --label "c0dev.tools_hash=$accepted" \
            --label "c0dev.tools_volume=$SHARED_TOOLS_VOLUME" --label "c0dev.base_image=$C0_BASE_IMAGE" \
            -t "$C0_RUNTIME_BUILD_TAG" "$C0_BUILD_CONTEXT" || exit 1
        c0_validate_runtime_image || exit 1
        image_id="$(cat "$C0_BUILD_CONTEXT/.runtime-image-id")" || exit 1
        c0_publish_runtime_image "$image_id"
    )
}

cmd_tools_accept() {
    local cid changes snapshot_dir stage_sha accepted_id metadata C0_TOOLS_HELPER_IMAGE

    c0_require_container_running || exit 1
    cid="$(get_c0_container_id)"
    c0_validate_container_mounts "$cid" true true || return 1
    set_tools_id "$C0_CONTAINER_TOOLS_ID" || return 1
    changes="$(c0_home_overlay_porcelain "$cid")" || return 1
    if [[ -z "$changes" ]]; then
        echo -e "${BOLD}tools:${NC} ${GREEN}clean${NC}"
        return 0
    fi
    metadata="$(c0_accept_runtime_metadata "$cid")" || return 1
    C0_TOOLS_HELPER_IMAGE="$(c0_tools_helper_image)" || return 1

    cmd_tools_stage_output false || return 1
    echo ""
    echo -e "📦 Accepting the complete writable tools stage..."

    snapshot_dir="$(mktemp -d "${TMPDIR:-/tmp}/c0-tools-accept.XXXXXX")"
    chmod 700 "$snapshot_dir"
    : >"$snapshot_dir/policy"
    if ! c0_snapshot_home_overlays "$cid" "$snapshot_dir"; then
        rm -rf "$snapshot_dir"
        exit 1
    fi
    trap 'rm -rf "$snapshot_dir"; exit 130' INT TERM

    stage_sha="$(
        cd "$snapshot_dir"
        find . -type f -name '*.tar' -print0 \
            | LC_ALL=C sort -z \
            | xargs -0 shasum -a 256 \
            | shasum -a 256 \
            | awk '{print $1}'
    )"
    accepted_id="$(printf 'c0-tools-accept-v1\n%s\n%s\n' "$TOOLS_ID" "$stage_sha" | shasum -a 256 | awk '{print $1}')"

    if ! c0_publish_home_overlay_snapshot "$snapshot_dir" "$TOOLS_ID" "$accepted_id" "$stage_sha"; then
        rm -rf "$snapshot_dir"
        trap - INT TERM
        exit 1
    fi
    rm -rf "$snapshot_dir"
    trap - INT TERM

    c0_publish_accepted_runtime "$metadata" "$accepted_id" || return 1
    echo -e "✅ Accepted tools: ${GREEN}${accepted_id:0:12}...${NC}"
    echo "warning: the running guest still uses its mounted tools snapshot and writable stage; its fixed Docker mount cannot change in place" >&2
}

# A tools restore must never modify a retained guest that shares this volume.
c0_require_exclusive_overlay_volume() {
    local cid="$1" volume="$2" references reference
    references="$(docker ps -aq --no-trunc --filter "volume=$volume")" || return 1
    while IFS= read -r reference; do
        [[ -z "$reference" || "$reference" == "$cid" ]] && continue
        echo "error: tools stage is also used by container $reference; refusing to discard shared guest data" >&2
        return 1
    done <<<"$references"
}

c0_clear_tools_stage() {
    local volume="$1" tools_id="$2" image="$3" guest_rel tools_rel extra name
    local -a names=()
    [[ "$tools_id" =~ ^[0-9a-f]{64}$ ]] || return 1
    while IFS='|' read -r guest_rel tools_rel extra; do
        case "$guest_rel" in ''|'#'*) continue ;; esac
        c0_validate_overlay_row "$guest_rel" "$tools_rel" "$extra" || return 1
        name="$(c0_overlay_name "$guest_rel")"
        names+=("$name")
    done <"$HOME_OVERLAYS_FILE"
    [[ "${#names[@]}" -gt 0 ]] || return 0
    docker run --rm --pull=never --network none --read-only --user 0:0 \
        --cap-drop ALL --cap-add DAC_OVERRIDE --cap-add FOWNER \
        --security-opt no-new-privileges:true \
        --mount "type=volume,src=$volume,dst=/state" \
        --entrypoint /bin/sh "$image" -eu -c '
            tools_id=$1
            shift
            for path in /state/upper /state/work "/state/work/$tools_id"; do
                [ ! -L "$path" ] && { [ ! -e "$path" ] || [ -d "$path" ]; } || {
                    echo "error: invalid tools stage directory: $path" >&2; exit 1;
                }
            done
            # Leave launcher state and stages for any other tools ID untouched.
            for name do
                rm -rf -- "/state/upper/$name" "/state/work/$tools_id/$name"
            done
        ' c0-tools-restore "$tools_id" "${names[@]}"
}

cmd_tools_restore() {
    local cid changes selected volume image result=0

    c0_require_container_running || return 1
    cid="$C0_RUNTIME_CID"
    c0_validate_container_mounts "$cid" true true || return 1
    set_tools_id "$C0_CONTAINER_TOOLS_ID" || return 1
    selected="$TOOLS_ID"
    if docker image inspect "$(c0_runtime_recipe_ref)" >/dev/null 2>&1; then
        selected="$(c0_resolve_shared_build >/dev/null && printf '%s\n' "$TOOLS_BUILD_ID")" || return 1
    fi
    if [[ -n "$selected" && "$selected" != "$TOOLS_ID" ]]; then
        echo "error: accepted tools differ from the guest's fixed Docker mount; cannot restore that selection in place; guest data was not changed" >&2
        return 1
    fi
    changes="$(c0_home_overlay_porcelain "$cid")" || return 1
    if [[ -z "$changes" ]]; then
        echo -e "${BOLD}tools:${NC} ${GREEN}clean${NC}"
        return 0
    fi
    volume="$(c0_overlay_volume_for_container "$cid")" || return 1
    c0_require_exclusive_overlay_volume "$cid" "$volume" || return 1
    image="$(c0_tools_helper_image)" || return 1

    cmd_tools_stage_output false || return 1
    echo ""
    echo -e "🧹 Restoring the mounted tools snapshot and discarding its writable stage..."
    docker stop "$cid" >/dev/null || return 1
    trap 'docker start "$cid" >/dev/null 2>&1; c0_start_ready "$cid" true; exit 130' INT TERM
    # Recheck after stopping; no stage mutation happens if another guest owns it.
    if c0_require_exclusive_overlay_volume "$cid" "$volume"; then
        c0_clear_tools_stage "$volume" "$TOOLS_ID" "$image" || result=1
    else
        result=1
    fi
    # Even a failed clear must resume the same guest, with all rootfs data retained.
    if ! docker start "$cid" >/dev/null; then
        trap - INT TERM
        return 1
    fi
    trap - INT TERM
    c0_start_ready "$cid" true || return 1
    [[ "$result" -eq 0 ]] || return "$result"
    echo -e "✅ Restored tools: ${GREEN}${TOOLS_ID:0:12}...${NC}"
}

cmd_tools() {
    require_host "tools"
    c0_require_docker || exit 1

    case "${1:-}" in
        '')       cmd_tools_stage_output false ;;
        --detail) cmd_tools_stage_output true ;;
        accept)   cmd_tools_accept ;;
        restore)  cmd_tools_restore ;;
        *)
            echo "error: usage: c0 tools [--detail|accept|restore]" >&2
            exit 1
            ;;
    esac
}

# Host umask for exec'd shells. runc applies no default umask to exec
# processes, so they inherit the engine daemon's (0000 under OrbStack), and
# Compose has no `umask` key to set HostConfig.Umask. Carry the host's value.
c0_host_umask() {
    local m
    m="$(umask)"
    if [[ ! "$m" =~ ^[0-7]{3,4}$ ]]; then
        echo "error: unexpected host umask: $m" >&2
        return 1
    fi
    echo "$m"
}

# Execute against the resolved ID, never Compose's independent service selector.
c0_exec_shell() {
    local user="$1" login="$2" cid="$C0_RUNTIME_CID" project_path host_umask command
    host_umask="$(c0_host_umask)" || return 1
    project_path="$(get_project_path)"
    command="umask $host_umask && "
    if [[ -n "$project_path" ]]; then
        command+="cd $(printf '%q' "$CONTAINER_DEV_HOME/projects/$project_path") && "
    fi
    command+="exec /bin/bash$login"
    local tty=0 term=""
    if [[ -t 0 && -t 1 ]]; then
        tty=1
        term="${TERM:-}"
        "$C0ROOT/bin/c0-terminfo" sync "$cid" || return 1
    fi
    print_web_port_mapping
    echo -e "🐚 Shell: ${CYAN}$cid${NC} (uid $user)"
    c0_credentials docker "$C0_AUTH_ENV_FILE" "$cid" "$user" "$tty" "$term" /bin/bash -c "$command"
}

cmd_sh() {
    require_host "sh"
    c0_require_container_running || return 1
    c0_validate_container_mounts "$C0_RUNTIME_CID" true true || return 1
    c0_exec_shell 1000 ' -l'
}

cmd_root() {
    require_host "root"
    c0_require_container_running || return 1
    c0_validate_container_mounts "$C0_RUNTIME_CID" true true || return 1
    c0_exec_shell 0 ''
}

cmd_cp_term() {
    require_host "cp-term"
    c0_require_container_running || return 1
    local term container_name="$C0_RUNTIME_CID"
    for term in xterm-256color "$TERM"; do
        (set -o pipefail; infocmp -xa "$term" | docker exec -u 0 -i "$container_name" tic -x -o /usr/share/terminfo/ -) || return 1
        echo -e "✅ Copied: ${CYAN}$term${NC}"
    done
}

# Wait for the entire worker group, including Docker CLI plugins, to disappear.
# A reaped shell does not imply that its grandchildren have exited.
c0_build_wait_group() {
    local pgid="$1" attempts="$2"
    while kill -0 -- "-$pgid" 2>/dev/null; do
        (( attempts > 0 )) || return 1
        sleep 0.1
        attempts=$((attempts - 1))
    done
}

c0_build_cancel_group() {
    local pgid="$1" signal="$2"
    kill -s "$signal" -- "-$pgid" 2>/dev/null || true
    # Deliver pending cancellation even if a descendant was suspended separately.
    kill -CONT -- "-$pgid" 2>/dev/null || true
    if ! c0_build_wait_group "$pgid" 50; then
        kill -TERM -- "-$pgid" 2>/dev/null || true
        if ! c0_build_wait_group "$pgid" 20; then
            kill -KILL -- "-$pgid" 2>/dev/null || true
        fi
    fi
    wait "$pgid" 2>/dev/null || true
    c0_build_wait_group "$pgid" 20
}

c0_build_cleanup() {
    local resolved_id
    if [[ -f "$C0_BUILD_CONTEXT/.c0-build-id" ]]; then
        resolved_id="$(cat "$C0_BUILD_CONTEXT/.c0-build-id")"
        if [[ "$resolved_id" =~ ^[0-9a-f]{64}$ ]]; then
            TOOLS_BUILD_ID="$resolved_id"
        fi
    fi
    local tag="c0dev-tools-builder-${C0_MODE_KEY}:$TOOLS_BUILD_ID"
    docker rmi "$tag" >/dev/null 2>&1 || true
    tools_volume_exists || return 0
    # Cancellation must not download an image merely to clean up a partial tree.
    c0_docker_run --pull=never --network none --cap-add DAC_OVERRIDE --cap-add FOWNER \
        -v "$SHARED_TOOLS_VOLUME:/tools" alpine \
        rm -rf "/tools/tmp/$TOOLS_BUILD_ID.partial" >/dev/null 2>&1 || true
}

cmd_build() {
    require_host "build"
    local worker cleanup_worker result=0 interrupted="" interrupt_status=0
    local monitor=false saved_traps build_dir keep_context=false
    build_dir="$(mktemp -d "${TMPDIR:-/tmp}/c0-build.XXXXXX")" || return 1
    local C0_BUILD_CONTEXT="$build_dir/context"
    local DOCKERFILE_TOOLS_BUILD="$C0_BUILD_CONTEXT/Dockerfile.tools.build"
    local DOCKERFILE_RUNTIME_BUILD="$C0_BUILD_CONTEXT/Dockerfile.runtime.build"
    local -a C0_TOOLCHAIN_BUILD_ARGS=()
    [[ $- == *m* ]] && monitor=true
    saved_traps="$(trap -p INT TERM HUP)"

    # Record signals even in the brief interval before $! has been assigned.
    trap 'interrupted=INT; interrupt_status=130' INT
    trap 'interrupted=TERM; interrupt_status=143' TERM
    trap 'interrupted=TERM; interrupt_status=129' HUP

    # Monitor mode assigns a separate process group without setsid (not available
    # on stock macOS). Only the worker disables it, keeping its whole tree in that
    # group. Explicit stdin redirection preserves the caller's input descriptor.
    set -m
    (
        set +m
        trap 'exit 130' INT
        trap 'exit 143' TERM
        trap 'exit 129' HUP
        c0_build_steps "$@"
    ) <&0 &
    worker=$!
    [[ "$monitor" == true ]] || set +m

    if [[ -z "$interrupted" ]]; then
        if wait "$worker"; then result=0; else result=$?; fi
    fi
    if [[ -n "$interrupted" ]]; then
        # Repeated interrupts must not abandon cancellation or artifact cleanup.
        trap '' INT TERM HUP
        echo -e "\n${RED}build interrupted${NC}" >&2
        if c0_build_cancel_group "$worker" "$interrupted"; then
            # Cleanup runs only after cancellation; bound it as well if Docker hangs.
            set -m
            ( set +m; c0_build_cleanup ) <&0 &
            cleanup_worker=$!
            [[ "$monitor" == true ]] || set +m
            if ! c0_build_wait_group "$cleanup_worker" 50; then
                c0_build_cancel_group "$cleanup_worker" TERM || true
            else
                wait "$cleanup_worker" 2>/dev/null || true
            fi
        else
            keep_context=true
            echo "warning: build processes have not exited; retaining context at $build_dir" >&2
        fi
        result=$interrupt_status
    fi
    if [[ "$keep_context" != true ]]; then rm -rf "$build_dir"; fi
    trap - INT TERM HUP
    if [[ -n "$saved_traps" ]]; then eval "$saved_traps"; fi
    return "$result"
}

c0_build_steps() {
    require_host "build"

    local force=false
    local nocache=""
    if [[ "$1" == "-f" || "$1" == "--force" ]]; then
        force=true
        nocache="--no-cache"
        echo -e "🔨 ${YELLOW}Force rebuild${NC} requested"
    fi

    if ! verify_moby_seccomp_profile; then
        echo "error: seccomp profile verification failed" >&2
        exit 1
    fi
    maybe_notify_seccomp_update_available || true
    c0_ssh_ensure_keys
    c0_prepare_build_context || exit 1
    echo -e "📄 Preparing terminfo..."
    c0_prepare_terminfo || exit 1
    # Release lookups are supervised and must succeed even when a tools snapshot
    # exists; stale metadata is never substituted after an upstream failure.
    c0_resolve_toolchain || exit 1

    if ! c0_build_base_image "$nocache"; then
        echo 'error: base image build or validation failed' >&2
        exit 1
    fi

    # Build/validate tools volume
    if ! build_tools_volume "$force" "$nocache"; then
        echo "error: tools build failed" >&2
        exit 1
    fi

    # Build service image
    echo -e "🏗️  Building service image..."
    export DOCKER_BUILDKIT=1
    c0_prepare_runtime_dockerfile
    if ! c0_build_runtime_image "$nocache"; then
        echo "error: image build failed" >&2
        exit 1
    fi

    # Run garbage collection after successful build (Phase 5)
    gc_tools_hashes

    echo -e "✅ ${GREEN}Build complete${NC}"
}

cmd_clean() {
    require_host "clean"
    c0_require_docker || return 1
    local clean_all=false references published remaining
    case "${1:-}" in
        '') [[ $# -eq 0 ]] || return 1 ;;
        --all|-a) [[ $# -eq 1 ]] || return 1; clean_all=true ;;
        *) echo "error: usage: c0 clean [--all]" >&2; return 1 ;;
    esac
    if ! tools_volume_exists; then
        echo -e "${YELLOW}volume $SHARED_TOOLS_VOLUME does not exist${NC}"
        return 0
    fi
    references="$(list_container_ids_using_tools_volume)" || return 1
    if [[ -n "$references" ]]; then
        echo 'error: tools storage is referenced by Docker containers; nothing was removed' >&2
        return 1
    fi
    if [[ "$clean_all" == true ]]; then
        published="$(get_published_tools_hashes)" || return 1
        if [[ -n "$published" ]]; then
            echo 'error: tools storage is referenced by published images; nothing was removed' >&2
            return 1
        fi
    fi
    gc_tools_hashes || return 1
    if [[ "$clean_all" == true ]]; then
        remaining="$(tools_volume_sh "find /tools -mindepth 1 -maxdepth 1 ! -name opt ! -name tmp -print; find /tools/opt /tools/tmp -mindepth 1 -maxdepth 1 -print 2>/dev/null || true")" || return 1
        if [[ -n "$remaining" ]]; then
            echo 'error: retained tools or legacy data remains; tools volume was not removed' >&2
            return 1
        fi
        docker volume rm "$SHARED_TOOLS_VOLUME" >/dev/null || return 1
        echo -e "✅ Removed unused tools cache: ${GREEN}$SHARED_TOOLS_VOLUME${NC}"
    fi
}

cmd_help() {
    if [[ "$IN_CONTAINER" == "true" ]]; then
        cat <<EOF
Usage: c0 {help}

Commands (inside container):
  help          Show this help message

Note: Running inside container. Use 'exit' to return to host.
EOF
    else
        cat <<EOF
Usage: c0 {start|stop|restart|logs|status|tools|sh|root|ssh|orca|cp-term|build|clean|seccomp-upgrade|help}

Commands:
  start [--least-privilege]
                Resume an existing instance, or create one using the built
                image and selected tools when absent. Stop removes the runtime.
  stop          Stop and remove this runtime; retain bind mounts and volumes.
  restart       Stop, then start this instance.
  logs [svc]    Show logs (default: $MAIN_SERVICE)
  status        Show this instance (realpath-keyed); docker errors are fatal
  tools [--detail|accept|restore]
                Show the writable tools stage, accept it as an immutable
                snapshot, or discard it and restore the accepted snapshot
  sh            Shell as dev user (uid 1000); loads auth/.env if present
  root          Shell as root (uid 0); loads auth/.env if present
  ssh [-Y] [command...] | ssh --keygen
                SSH as dev (127.0.0.1). Each attach restores literal auth/.env values in the guest.
                -Y enables trusted X11 forwarding; --keygen prepares SSH keys.
                Only the private environment envelope and locale are forwarded; client keys stay host-only.
  orca [start|stop|status]
                Guest orca serve. Bare \`c0 orca\` is status, not start.
                start backgrounds serve with --pairing-address <compose-ipv4>
                and prints Orca's own URLs. Host attaches at compose-ipv4:6768
                (same IP as ssh's dev@ip:2222). No localhost mapping.
  cp-term       Copy caller terminfo system-wide; sh/ssh also sync it as dev.
  build [-f]    Build tools and image (-f forces tools re-extract)
                TOOLS_BUILD_ID = hash(recipe identity + freshly resolved toolchain manifest).
                Docker image labels select the completed tools payload.
  seccomp-upgrade [--dry-run]
                Use git ls-remote on moby/profiles, pick latest seccomp/vM.m.p tag,
                curl raw default.json, verify sha256, then rewrite docker/seccomp when newer.
                --dry-run shows target tag, peeled commit OID, profile sha256; no writes.
  clean [-a]    Remove shared tools volume hashes only (never host .cache or projects).
                Refuses while any guest/recovery uses the store; never removes containers.
                Collects unused rebuildable tools. (-a removes an entirely unused store)
  help          Show this help message

Environment:
  C0_MODE       Set to 'dev' for dev mode (default: production)
  C0_SECURITY   guest-admin (default) or least-privilege; overridden by start --least-privilege
  C0_SECCOMP_NOTIFY=0  Skip upstream seccomp "newer available" notices on build/start
  MOBY_PROFILES_GIT_URL  Override moby/profiles.git URL (default https://github.com/moby/profiles.git)

Notes:
  - Mode/build artifacts are shared; working folders add container isolation.
  - Docker tags, labels and mounts provide discovery; no c0 state files are written.
  - Tools referenced by active, stopped, or recovery containers are protected
  - Force rebuild of active tools_id stages to .next, promotes after stop
  - Ephemeral docker runs during build use --cap-drop ALL and no-new-privileges; tools-volume
    rotation/GC helpers add back only DAC_OVERRIDE and FOWNER to remove dev-owned snapshots
  - Home OverlayFS mounts use a one-shot capability-scoped helper that joins only the container
    mount namespace, mounts read-only tool lowers over per-instance writable state, then exits
  - Runtime: cap_drop ALL then guest-admin caps (DAC_OVERRIDE, CHOWN, FOWNER); not host root
  - least-privilege drops all guest capabilities; guest-admin adds CHOWN, DAC_OVERRIDE, FOWNER
  - Moby seccomp updates: notices on build/start if upstream tag is newer; run seccomp-upgrade to apply
  - SSH agent: compose fragment binds OrbStack /run/host-services/ssh-auth.sock at the same
    guest path and sets SSH_AUTH_SOCK. Requires host \$SSH_AUTH_SOCK. C0_SSH_AGENT=0 disables.
  - SSH login: host -> dev via 127.0.0.1:<port> (auto 2222-2322 -> guest:2222). Server auth in auth/ssh/; host client keys in auth/ssh-client/.
    sshd runs as dev; loopback publish only. Override: C0DEV_SSH_PORT.
  - X11: c0 ssh -Y tunnels trusted X11 to the host DISPLAY; requires a running host X server.
  - Orca: c0 orca is status. c0 orca start backgrounds guest serve at
    compose-ipv4:6768 (--pairing-address is that IPv4; cwd/--project-root
    /home/dev/projects). No SSH -L and no host localhost port. Pairing,
    advertised, and web URLs are Orca's own stdout.
  - auth/.env (optional, gitignored): NAME="value" or export NAME="value" per line; host-only.
    c0 sh / c0 root: private pipe-backed env-file. c0 ssh: framed SendEnv envelope only.
    Values never become transport argv or host control variables; a fixed guest bootstrap
    restores the requested environment. auth/ssh-client is never mounted into the guest.
  - Tools: selected immutable snapshot at /tools/current:ro. Mutable caches (cargo
    registry, uv) live in host ./.cache/; c0 never purges them — remove manually if needed.
EOF
    fi
}

# =============================================================================
# Main
# =============================================================================

case "${1:-}" in
    start)      shift; cmd_start "$@" ;;
    stop)       cmd_stop ;;
    restart)    shift; cmd_restart "$@" ;;
    logs)       shift; cmd_logs "$@" ;;
    status)     cmd_status ;;
    tools)      shift; cmd_tools "$@" ;;
    sh)         cmd_sh ;;
    root)       cmd_root ;;
    ssh)        shift; cmd_ssh "$@" ;;
    orca)       shift; cmd_orca "$@" ;;
    cp-term)    cmd_cp_term ;;
    build)      shift; cmd_build "$@" ;;
    clean)      shift; cmd_clean "$@" ;;
    seccomp-upgrade) shift; cmd_seccomp_upgrade "$@" ;;
    help|--help|-h)
                cmd_help ;;
    *)
        if [[ "$IN_CONTAINER" == "false" ]]; then
            cmd_status
            echo ""
        fi
        cmd_help
        ;;
esac
