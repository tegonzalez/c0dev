"""Private credential transport; auth data never configures a host process."""
import base64
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import threading
import tempfile

sys.dont_write_bytecode = True
PREFIX = 'C0_SESSION_ENV'
# Docker's kvfile reader has a 64-KiB line ceiling. Chunking is framing,
# not a cap on credential length or count; each generated line stays below it.
CHUNK_BYTES = 32 * 1024
GUEST_BOOTSTRAP = r'''
import base64,json,os,re,sys
try:
    captured={k:os.environ.pop(k) for k in list(os.environ) if k.startswith('C0_SESSION_ENV')}
    marker=captured.pop('C0_SESSION_ENV')
    if not re.fullmatch(r'1:[1-9][0-9]*',marker): raise ValueError()
    count=int(marker[2:])
    if count!=len(captured): raise ValueError()
    text=''.join(captured['C0_SESSION_ENV_%04d'%i] for i in range(count))
    envelope=json.loads(base64.b64decode(text,validate=True).decode('utf-8'))
    if set(envelope)!={'schema','values'} or type(envelope['schema']) is not int or envelope['schema']!=1: raise ValueError()
    values=envelope['values']
    if not isinstance(values,dict): raise ValueError()
    for k,v in values.items():
        if not isinstance(k,str) or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*',k) or k.startswith('C0_SESSION_ENV') or not isinstance(v,str) or '\x00' in v: raise ValueError()
    program=sys.argv[1]
    arguments=sys.argv[1:]
    if not program.startswith('/'): raise ValueError()
except (KeyError,ValueError,TypeError,IndexError):
    sys.stderr.write('error: private credential environment was not accepted\n')
    sys.exit(1)
try:
    os.environ.update(values)
    os.execv(program,arguments)
except (OSError,ValueError,UnicodeError):
    sys.stderr.write('error: cannot start the requested guest program\n')
    sys.exit(1)
'''.strip()


def host_io():
    path = Path(__file__).resolve().with_name('c0-host-io')
    loader = importlib.machinery.SourceFileLoader('c0_host_io_private', str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def read_auth(root, path):
    if not path:
        return {}
    io = host_io()
    parent = descriptor = None
    try:
        try:
            parent, name = io.parent_fd(root, path)
            descriptor = io.open_regular(parent, name, os.O_RDONLY)
        except FileNotFoundError:
            return {}
        with os.fdopen(descriptor, 'rb', closefd=False) as source:
            text = source.read().decode('utf-8')
    finally:
        if descriptor is not None:
            os.close(descriptor)
        if parent is not None:
            os.close(parent)
    values = {}
    for number, line in enumerate(text.split('\n'), 1):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        match = re.fullmatch(r'(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)', line)
        if not match:
            print('warning: auth/.env:{}: skipped invalid assignment'.format(number), file=sys.stderr)
            continue
        name, raw = match.groups()
        if name.startswith(PREFIX):
            raise ValueError('reserved private transport name')
        value = decode_value(raw)
        if value is None:
            print('warning: auth/.env:{}: skipped invalid literal'.format(number), file=sys.stderr)
            continue
        if '\x00' in value:
            raise ValueError('credential contains an unsupported NUL')
        values[name] = value
    return values


def decode_value(raw):
    if len(raw) >= 2 and raw[0] == raw[-1] == '"':
        inner = raw[1:-1]
        out = []
        index = 0
        while index < len(inner):
            value = inner[index]
            if value == '\\' and index + 1 < len(inner) and inner[index + 1] in '\\"$`':
                index += 1
                value = inner[index]
            out.append(value)
            index += 1
        return ''.join(out)
    if len(raw) >= 2 and raw[0] == raw[-1] == "'":
        return raw[1:-1] if "'" not in raw[1:-1] else None
    return None if re.search(r'[\s$`;\&|<>()]', raw) else raw


def envelope(values):
    raw = json.dumps({'schema': 1, 'values': values}, ensure_ascii=True,
                     separators=(',', ':')).encode('utf-8')
    encoded = base64.b64encode(raw).decode('ascii')
    chunks = [encoded[i:i + CHUNK_BYTES] for i in range(0, len(encoded), CHUNK_BYTES)]
    result = {PREFIX: '1:' + str(len(chunks))}
    result.update((PREFIX + '_%04d' % i, value) for i, value in enumerate(chunks))
    return result


def launch(arguments, environment, pipe_data=None):
    process = None
    reader = writer = None
    failures = []
    interrupted = []
    previous = {}

    def relay(signum, _frame):
        interrupted.append(signum)
        if process is not None and process.poll() is None:
            try:
                process.send_signal(signum)
            except ProcessLookupError:
                pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        previous[signum] = signal.signal(signum, relay)
    try:
        if pipe_data is not None:
            reader, writer = os.pipe()
            arguments = [('/dev/fd/' + str(reader)) if value == '__C0_PRIVATE_ENV_FD__'
                         else value for value in arguments]
        process = subprocess.Popen(arguments, env=environment,
                                   pass_fds=() if reader is None else (reader,))
        if reader is not None:
            os.close(reader)
            reader = None
            owned_writer, writer = writer, None

            def send():
                try:
                    with os.fdopen(owned_writer, 'wb') as output:
                        output.write(pipe_data)
                except OSError:
                    failures.append(True)

            thread = threading.Thread(target=send, daemon=True)
            thread.start()
        for signum in interrupted:
            if process.poll() is None:
                try:
                    process.send_signal(signum)
                except ProcessLookupError:
                    pass
        status = process.wait()
        if pipe_data is not None:
            thread.join()
        if interrupted:
            return 128 + interrupted[-1]
        if status == 0 and failures:
            return 1
        return status if status >= 0 else 128 - status
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)
        if reader is not None:
            os.close(reader)
        if writer is not None:
            os.close(writer)


def main(argv):
    if len(argv) < 4:
        raise ValueError('missing private transport arguments')
    root, operation, auth = argv[1:4]
    # Capture host configuration before loading any credential data. Auth never
    # updates os.environ, the executable lookup, Docker context, or SSH options.
    environment = {k: v for k, v in os.environ.items() if not k.startswith(PREFIX)}
    if operation == 'docker':
        if len(argv) < 9:
            raise ValueError('missing Docker attachment arguments')
        cid, uid, tty, term = argv[4:8]
        program = argv[8:]
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*', cid) or uid not in ('0', '1000') or tty not in ('0', '1') or not program[0].startswith('/'):
            raise ValueError('invalid Docker attachment')
        executable = shutil.which('docker', path=environment.get('PATH'))
        if not executable:
            raise ValueError('Docker unavailable')
        values = read_auth(root, auth)
        if tty == '1' and term:
            values['TERM'] = term
        transport = envelope(values)
        data = ''.join(k + '=' + v + '\n' for k, v in transport.items()).encode('ascii')
        arguments = [executable, 'exec', '-i', '-u', uid, '--env-file', '__C0_PRIVATE_ENV_FD__']
        if tty == '1':
            arguments.append('-t')
        arguments += [cid, '/usr/bin/python3', '-I', '-c', GUEST_BOOTSTRAP] + program
        return launch(arguments, environment, data)
    if operation in ('ssh', 'ssh-batch'):
        if len(argv) != 9:
            raise ValueError('missing SSH attachment arguments')
        client, port, x11, tty, script = argv[4:9]
        if not port.isdecimal() or not 1 <= int(port) <= 65535 or x11 not in ('0', '1') or tty not in ('0', '1'):
            raise ValueError('invalid SSH attachment')
        executable = shutil.which('ssh', path=environment.get('PATH'))
        if not executable:
            raise ValueError('SSH unavailable')
        io = host_io()
        parent, _name = io.parent_fd(root, str(Path(client) / '.client-entry'))
        try:
            directory = os.fstat(parent)
            if directory.st_uid != os.geteuid() or stat.S_IMODE(directory.st_mode) & 0o077:
                raise ValueError('host client directory is not private')
            for name in ('id_ed25519', 'id_ed25519.pub', 'known_hosts'):
                info = io.current(parent, name)
                if name == 'id_ed25519' and (info is None or stat.S_IMODE(info.st_mode) & 0o077):
                    raise ValueError('missing or nonprivate host client key')
        finally:
            os.close(parent)
        values = read_auth(root, auth)
        if tty == '1' and environment.get('TERM'):
            values['TERM'] = environment['TERM']
        environment.update(envelope(values))
        # OpenSSH interprets spaces, % tokens and ${...} in file options.
        # A private host-created directory alias gives it stable literal paths
        # without copying key bytes or changing persistent known-hosts storage.
        temporary_root = '/private/tmp' if sys.platform == 'darwin' else '/tmp'
        with tempfile.TemporaryDirectory(prefix='c0-ssh-client-', dir=temporary_root) as temporary:
            selected_client = Path(temporary) / 'client'
            os.symlink(os.path.realpath(client), selected_client, target_is_directory=True)
            arguments = [executable, '-i', str(selected_client / 'id_ed25519'),
                         '-o', 'StrictHostKeyChecking=accept-new',
                         '-o', 'UserKnownHostsFile=' + str(selected_client / 'known_hosts'),
                         '-o', 'IdentityAgent=none', '-o', 'IdentitiesOnly=yes',
                         '-o', 'LogLevel=ERROR', '-p', port]
            if operation == 'ssh-batch':
                arguments += ['-o', 'BatchMode=yes']
            for name in list(environment):
                if name.startswith(PREFIX):
                    arguments += ['-o', 'SendEnv=' + name]
            if x11 == '1':
                arguments.append('-Y')
            if tty == '1':
                arguments.append('-t')
            remote = shlex.join(['/usr/bin/python3', '-I', '-c', GUEST_BOOTSTRAP,
                                 '/bin/bash', '-lc', script])
            return launch(arguments + ['dev@127.0.0.1', remote], environment)
    raise ValueError('unknown private credential operation')


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except (OSError, ValueError, UnicodeError, TypeError):
        print('error: credential transport refused unsafe input or unavailable prerequisite', file=sys.stderr)
        sys.exit(1)
