# Final runtime stage (concatenated with Dockerfile.base at build time)
FROM base

# c0 runs with no-new-privileges and without bwrap isolation; Electron's sandbox cannot initialize.
ENV ELECTRON_DISABLE_SANDBOX=1

# Vendored from https://downloads.1password.com/linux/keys/1password.asc (do not fetch at build)
COPY 1password.asc /usr/share/keyrings/1password-archive-keyring.asc
# Vendored from curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o cloud.google.gpg
COPY cloud.google.gpg /usr/share/keyrings/

RUN echo 'deb [arch=arm64 signed-by=/usr/share/keyrings/1password-archive-keyring.asc] https://downloads.1password.com/linux/debian/arm64 stable main' | tee /etc/apt/sources.list.d/1password.list
RUN echo 'deb [arch=arm64 signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' | tee /etc/apt/sources.list.d/google-cloud-sdk.list

RUN apt update

RUN apt install -y \
    locales procps attr \
    bc fzf jq yq \
    iproute2 iputils-ping net-tools socat netcat-traditional \
    strace zsh \
    tmux vim neovim \
    wget bat btop tree \
    pandoc poppler-utils \
    openssh-server xauth \
    1password-cli \
    file xvfb dbus dbus-x11 zlib1g-dev ca-certificates \
    libgtk-3-0t64 libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libgbm1 libasound2t64 \
    libxtst6 libcups2t64 libdrm2 libxkbcommon0 libpango-1.0-0 libcairo2 libatspi2.0-0t64 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxrender1 libx11-xcb1 \
    libxcb-dri3-0 libxss1

COPY install-orca.sh /usr/local/libexec/install-orca.sh
RUN /bin/sh /usr/local/libexec/install-orca.sh

RUN printf 'APT::Sandbox::User "root";\n' > /etc/apt/apt.conf.d/01c0dev-no-sandbox

# && rm -rf /var/lib/apt/lists/*

# Install global bun packages
RUN bun i -g opencode-ai@latest
RUN bun i -g @openai/codex@latest
RUN bun i -g @anthropic-ai/claude-code@latest
# > 300s WTAF??
# RUN bun i -g @google/gemini-cli@latest
RUN bun i -g @kaitranntt/ccs

# errata: handle bun -g installing as local user garbage
RUN chmod +rx /root

# Set the locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Set timezone (default to Los Angeles, can be overridden with TZ env var)
ARG TZ=America/Los_Angeles
ENV TZ=${TZ}
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Copy terminfo
COPY .terminfo /tmp/.terminfo
RUN for term in /tmp/.terminfo/*; do tic -x -o /usr/share/terminfo $term; done

# Copy entrypoint script (bind-mounted from host at runtime; baked in for standalone runs)
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Set up dev user
USER dev
WORKDIR /home/dev

RUN echo '. "$HOME/bin/activate"' >> ~/.profile
ENV SHELL=/bin/bash
ENTRYPOINT [""]
